# Encabezados de seguridad (Cloudflare Pages / Netlify).
# La regla más específica gana; /admin/* hereda lo no redefinido de /*.
# CSP pública: solo embeds de la lista cerrada de la propuesta §6.3.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; worker-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.ytimg.com; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com https://drive.google.com https://docs.google.com https://www.instagram.com; frame-ancestors 'none'

# El panel de Sveltia CMS se sirve en /admin/*: necesita su propio CSP
# (scripts de unpkg, conexiones a GitHub/netlify) y COOP para el login emergente.
/admin/*
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https:; frame-src 'self' https:

# Ambiente de desarrollo en Cloudflare (*.workers.dev): no indexar. No afecta al
# dominio definitivo (el patrón no lo alcanza), así que puede quedarse igual.
https://*.workers.dev/*
  X-Robots-Tag: noindex