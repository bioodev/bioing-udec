---
// Página libre: texto creado desde el panel (src/content/paginas-libres). Solo las publicadas tienen ruta.
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Migas from '@/components/Migas.astro';
import { paginasLibres } from '@/lib/contenido';
import { migas } from '@/lib/schema';

export async function getStaticPaths() {
  const paginas = await paginasLibres();
  return paginas.map((pagina) => ({ params: { id: pagina.id }, props: { pagina } }));
}

interface Props { pagina: CollectionEntry<'paginasLibres'> }
const { pagina } = Astro.props;
const { Content } = await render(pagina);

const enlace = `/paginas/${pagina.id}`;
const rutas = [
  { name: 'Inicio', url: '/' },
  { name: pagina.data.titulo, url: enlace },
];
---
<Base titulo={pagina.data.titulo} descripcion={pagina.data.bajada} imagen={pagina.data.imagen?.src} jsonLd={migas(rutas, Astro.site)}>
  <article class="mx-auto w-full max-w-3xl px-4 py-12">
    <header>
      <Migas items={rutas} />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight">{pagina.data.titulo}</h1>
      <p class="mt-4 text-xl text-muted-foreground">{pagina.data.bajada}</p>
      {pagina.data.imagen && <Image src={pagina.data.imagen} alt={pagina.data.imagen_alt ?? ''} class="mt-8 aspect-video w-full rounded-lg object-cover" widths={[768, 1536]} sizes="(min-width: 768px) 768px, 100vw" />}
    </header>

    <div class="prose mt-8 max-w-none"><Content /></div>
  </article>
</Base>
