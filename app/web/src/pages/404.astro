---
import Base from '@/layouts/Base.astro';
---
<Base titulo="Página no encontrada" descripcion="La página que buscas no existe o fue movida.">
  <section id="no-encontrada" class="mx-auto flex max-w-3xl flex-col items-center justify-center px-4 py-24 text-center">
    <p class="text-sm font-semibold uppercase tracking-widest text-primary">Error 404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">Página no encontrada</h1>
    <p class="mt-4 text-muted-foreground">La página que buscas no existe o fue movida. Prueba con el buscador o vuelve al inicio.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-primary px-5 py-2 text-sm font-medium text-primary-foreground hover:opacity-90">Volver al inicio</a>
      <a href="/buscar" class="rounded-full border border-border px-5 py-2 text-sm font-medium hover:text-primary">Ir al buscador</a>
    </div>
  </section>
</Base>