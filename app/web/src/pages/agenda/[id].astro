---
import { getEntries, getEntry, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import EnlaceFicha from '@/components/EnlaceFicha.astro';
import TarjetaNoticia from '@/components/TarjetaNoticia.astro';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import { formatoFechaHora, noticiasDeActividad, publicados } from '@/lib/contenido';
import { actividadEsProxima, existentes } from '@/lib/reglas';
import { MODALIDADES, TIPOS_ACTIVIDAD } from '@/lib/agenda';
import CalendarBlank from 'phosphor-astro/CalendarBlank.astro';
import MapPin from 'phosphor-astro/MapPin.astro';
import Users from 'phosphor-astro/Users.astro';
import ArrowSquareOut from 'phosphor-astro/ArrowSquareOut.astro';

export async function getStaticPaths() {
  const actividades = await publicados('actividades');
  return actividades.map((actividad) => ({ params: { id: actividad.id }, props: { actividad } }));
}

interface Props { actividad: CollectionEntry<'actividades'> }
const { actividad } = Astro.props;
const { Content } = await render(actividad);

// EnlaceFicha necesita saber la colección de cada organizador (Persona u Organización).
const organizadores = (
  await Promise.all(
    actividad.data.organizadores.map(async (o) => {
      const entrada = await (o.tipo === 'persona' ? getEntry(o.persona) : getEntry(o.organizacion));
      return entrada && { coleccion: o.tipo === 'persona' ? ('personas' as const) : ('organizaciones' as const), entrada };
    }),
  )
).filter((o): o is NonNullable<typeof o> => o !== null && o !== undefined);

const expositores = existentes(await getEntries(actividad.data.expositores ?? []));
const areas = existentes(await getEntries(actividad.data.areas ?? []));
const noticias = await noticiasDeActividad(actividad.id);

const esProxima = actividadEsProxima(actividad.data, new Date());
const fin = actividad.data.fin;
const cuando = fin && fin.valueOf() !== actividad.data.inicio.valueOf()
  ? `${formatoFechaHora(actividad.data.inicio)} — ${formatoFechaHora(fin)}`
  : formatoFechaHora(actividad.data.inicio);
---
<Base titulo={actividad.data.titulo} descripcion={`${TIPOS_ACTIVIDAD[actividad.data.tipo]} · ${cuando}`}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <p class="flex flex-wrap items-center gap-2">
      <Badge variant="outline">{TIPOS_ACTIVIDAD[actividad.data.tipo]}</Badge>
      <Badge variant="default">{MODALIDADES[actividad.data.modalidad]}</Badge>
      {!esProxima && <Badge variant="secondary">Realizada</Badge>}
    </p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">{actividad.data.titulo}</h1>

    <dl class="mt-6 grid gap-2 text-sm">
      <div class="flex items-center gap-2">
        <dt class="sr-only">Fecha y hora</dt>
        <CalendarBlank class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
        <dd><time datetime={actividad.data.inicio.toISOString()}>{cuando}</time></dd>
      </div>
      {actividad.data.lugar && (
        <div class="flex items-center gap-2">
          <dt class="sr-only">Lugar</dt>
          <MapPin class="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
          <dd>{actividad.data.lugar}</dd>
        </div>
      )}
      {areas.length > 0 && (
        <div class="flex items-center gap-2">
          <dt class="sr-only">Áreas</dt>
          <dd class="text-muted-foreground">{areas.map((a) => a.data.nombre).join(' · ')}</dd>
        </div>
      )}
    </dl>

    {actividad.data.enlace_inscripcion && esProxima && (
      <p class="mt-6">
        <Button as="a" href={actividad.data.enlace_inscripcion} target="_blank" rel="noopener" class="rounded-full">
          Inscripción o información<ArrowSquareOut class="size-4" aria-hidden="true" />
        </Button>
      </p>
    )}

    {actividad.data.imagen && <Image src={actividad.data.imagen} alt="" class="mt-8 w-full rounded-lg" widths={[768, 1536]} sizes="(min-width: 768px) 768px, 100vw" />}

    <div class="prose mt-8 max-w-none"><Content /></div>

    {(organizadores.length > 0 || expositores.length > 0) && (
      <section class="mt-10 border-t border-border pt-6 text-sm">
        {organizadores.length > 0 && (
          <p class="flex items-start gap-2">
            <Users class="mt-0.5 size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
            <span><span class="text-muted-foreground">Organiza: </span>
              {organizadores.map((o, i) => <>{i > 0 && ', '}<EnlaceFicha coleccion={o.coleccion} entrada={o.entrada} /></>)}
            </span>
          </p>
        )}
        {expositores.length > 0 && (
          <p class="mt-2"><span class="text-muted-foreground">Expone: </span>
            {expositores.map((p, i) => <>{i > 0 && ', '}<EnlaceFicha coleccion="personas" entrada={p} /></>)}
          </p>
        )}
      </section>
    )}

    {noticias.length > 0 && (
      <section class="mt-12">
        <h2 class="text-2xl font-semibold">Cobertura</h2>
        <div class="mt-6 grid gap-6 md:grid-cols-2">{noticias.map((n) => <TarjetaNoticia noticia={n} />)}</div>
      </section>
    )}
  </article>
</Base>
