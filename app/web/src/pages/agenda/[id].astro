---
import { resolverSeo } from '@/lib/seo';
import { getEntries, getEntry, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import EnlaceFicha from '@/components/EnlaceFicha.astro';
import TarjetaNoticia from '@/components/TarjetaNoticia.astro';
import TiempoRelativo from '@/components/TiempoRelativo.astro';
import Incrustados from '@/components/Incrustados.astro';
import Enlaces from '@/components/Enlaces.astro';
import Distintivo from '@/components/Distintivo.astro';
import Compartir from '@/components/Compartir.astro';
import { formatoFechaHora, noticiasDeActividad, publicados, seoDeEntrada } from '@/lib/contenido';
import { actividadEsProxima, existentes } from '@/lib/reglas';
import { MODALIDADES, TIPOS_ACTIVIDAD } from '@/lib/agenda';
import { migas, actividad as jsonLdActividad } from '@/lib/schema';
import CalendarBlank from 'phosphor-astro/CalendarBlank.astro';
import MapPin from 'phosphor-astro/MapPin.astro';
import UsersThree from 'phosphor-astro/UsersThree.astro';
import Microphone from 'phosphor-astro/Microphone.astro';
import Books from 'phosphor-astro/Books.astro';

export async function getStaticPaths() {
  const actividades = await publicados('actividades');
  return actividades.map((actividad) => ({ params: { id: actividad.id }, props: { actividad } }));
}

interface Props { actividad: CollectionEntry<'actividades'> }
const { actividad } = Astro.props;
const { Content } = await render(actividad);

// EnlaceFicha necesita saber la colección de cada organizador (Persona u Organización).
const organizadores = (
  await Promise.all(
    actividad.data.organizadores.map(async (o) => {
      const entrada = await (o.tipo === 'persona' ? getEntry(o.persona) : getEntry(o.organizacion));
      return entrada && { coleccion: o.tipo === 'persona' ? ('personas' as const) : ('organizaciones' as const), entrada };
    }),
  )
).filter((o): o is NonNullable<typeof o> => o !== null && o !== undefined);

const expositores = existentes(await getEntries(actividad.data.expositores ?? []));
const areas = existentes(await getEntries(actividad.data.areas ?? []));
const noticias = await noticiasDeActividad(actividad.id);

const esProxima = actividadEsProxima(actividad.data, new Date());
const fin = actividad.data.fin;
const cuando = fin && fin.valueOf() !== actividad.data.inicio.valueOf()
  ? `${formatoFechaHora(actividad.data.inicio)} — ${formatoFechaHora(fin)}`
  : formatoFechaHora(actividad.data.inicio);

const enlace = `/agenda/${actividad.id}`;
const jsonLdPagina = [
  migas(
    [
      { name: 'Inicio', url: '/' },
      { name: 'Agenda', url: '/agenda' },
      { name: actividad.data.titulo, url: enlace },
    ],
    Astro.site,
  ),
  jsonLdActividad(actividad, {
    site: Astro.site,
    url: enlace,
    organizadores: organizadores.map((o) => ({
      tipo: o.coleccion === 'personas' ? ('persona' as const) : ('organizacion' as const),
      nombre: o.entrada.data.nombre,
      ...(o.coleccion === 'personas' && o.entrada.data.ficha_activa ? { url: `/personas/${o.entrada.id}` } : {}),
    })),
    expositores: expositores.map((p) => (p.data.ficha_activa ? { nombre: p.data.nombre, url: `/personas/${p.id}` } : { nombre: p.data.nombre })),
  }),
];
const seo = resolverSeo({ titulo: actividad.data.titulo, descripcion: `${TIPOS_ACTIVIDAD[actividad.data.tipo]} · ${cuando}` }, seoDeEntrada(actividad.data.seo));
---
<Base titulo={seo.titulo} descripcion={seo.descripcion} imagen={seo.imagen} noindex={seo.noindex} jsonLd={jsonLdPagina}>
  <article class="mx-auto w-full max-w-3xl px-4 py-12 lg:grid lg:max-w-6xl lg:grid-cols-[minmax(0,48rem)_18rem] lg:justify-center lg:gap-x-12">
    <header class="lg:col-start-1 lg:row-start-1">
      <div class="flex flex-wrap items-center gap-2">
        <Distintivo clase="tipo">{TIPOS_ACTIVIDAD[actividad.data.tipo]}</Distintivo>
        <Distintivo clase="modalidad" modalidad={actividad.data.modalidad}>{MODALIDADES[actividad.data.modalidad]}</Distintivo>
        {!esProxima && <Distintivo clase="realizada">Realizada</Distintivo>}
      </div>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight">{actividad.data.titulo}</h1>
    </header>

    {/* En móvil va entre el título y el cuerpo; en escritorio, columna lateral fija junto al texto. */}
    <aside aria-label="Información de la actividad" class="mt-8 rounded-lg bg-muted p-5 text-sm lg:sticky lg:top-24 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:self-start">
      <h2 class="sr-only">Datos de la actividad</h2>
      <dl class="grid gap-4">
        <div>
          <dt class="flex items-center gap-1.5 text-muted-foreground"><CalendarBlank class="size-4 shrink-0" aria-hidden="true" />Fecha y hora</dt>
          <dd class="mt-1 font-medium"><time datetime={actividad.data.inicio.toISOString()}>{cuando}</time><TiempoRelativo fecha={actividad.data.inicio} conHora /></dd>
        </div>
        {actividad.data.lugar && (
          <div>
            <dt class="flex items-center gap-1.5 text-muted-foreground"><MapPin class="size-4 shrink-0" aria-hidden="true" />Lugar</dt>
            <dd class="mt-1 font-medium">{actividad.data.lugar}</dd>
          </div>
        )}
        {areas.length > 0 && (
          <div>
            <dt class="flex items-center gap-1.5 text-muted-foreground"><Books class="size-4 shrink-0" aria-hidden="true" />Áreas</dt>
            <dd class="mt-1 font-medium">{areas.map((a) => a.data.nombre).join(' · ')}</dd>
          </div>
        )}
      </dl>

      {/* La inscripción es el botón principal solo mientras la Actividad es próxima; los Enlaces se ven siempre. */}
      <Enlaces
        principal={esProxima && actividad.data.enlace_inscripcion ? { etiqueta: 'Inscripción o información', url: actividad.data.enlace_inscripcion } : undefined}
        items={actividad.data.enlaces ?? []}
      />

      {(organizadores.length > 0 || expositores.length > 0) && (
        <dl id="actividad-datos" class="mt-6 grid gap-4 border-t border-border pt-6">
          {organizadores.length > 0 && (
            <div>
              <dt class="flex items-center gap-1.5 text-muted-foreground"><UsersThree class="size-4 shrink-0" aria-hidden="true" />Organiza</dt>
              <dd class="mt-1 font-medium">
                {organizadores.map((o, i) => <>{i > 0 && ', '}<EnlaceFicha coleccion={o.coleccion} entrada={o.entrada} /></>)}
              </dd>
            </div>
          )}
          {expositores.length > 0 && (
            <div>
              <dt class="flex items-center gap-1.5 text-muted-foreground"><Microphone class="size-4 shrink-0" aria-hidden="true" />Expone</dt>
              <dd class="mt-1 font-medium">
                {expositores.map((p, i) => <>{i > 0 && ', '}<EnlaceFicha coleccion="personas" entrada={p} /></>)}
              </dd>
            </div>
          )}
        </dl>
      )}

      <div class="mt-6 border-t border-border pt-6">
        <Compartir url={enlace} titulo={actividad.data.titulo} />
      </div>
    </aside>

    <div class="lg:col-start-1 lg:row-start-2">
      {actividad.data.imagen && <Image src={actividad.data.imagen} alt={actividad.data.imagen_alt ?? ''} class="mt-8 w-full rounded-lg" widths={[768, 1536]} sizes="(min-width: 768px) 768px, 100vw" />}

      <div class="prose mt-8 max-w-none"><Content /></div>

      <Incrustados items={actividad.data.incrustados ?? []} />

      {noticias.length > 0 && (
        <section id="actividad-cobertura" class="mt-12" aria-labelledby="actividad-cobertura-titulo">
          <h2 id="actividad-cobertura-titulo" class="text-2xl font-semibold">Cobertura</h2>
          <ul role="list" class="mt-6 grid gap-6 md:grid-cols-2">{noticias.map((n) => <li><TarjetaNoticia noticia={n} /></li>)}</ul>
        </section>
      )}
    </div>
  </article>
</Base>
