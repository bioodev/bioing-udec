---
import Base from '@/layouts/Base.astro';
import FiltrosPlegables from '@/components/FiltrosPlegables.astro';
import TarjetaActividad from '@/components/TarjetaActividad.astro';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/starwind/select';
import { actividadesRealizadas, proximasActividades } from '@/lib/contenido';
import { actividadEsProxima, normalizar } from '@/lib/reglas';
import { TIPOS_ACTIVIDAD } from '@/lib/agenda';
import { contarAgenda, TODAS, type EstadoActividad } from '@/lib/filtro-agenda';

// Un único "ahora" para particionar: próximas en orden ascendente y pasadas en descendente.
const ahora = new Date();
const proximas = await proximasActividades(ahora);
const realizadas = await actividadesRealizadas(ahora);

const todas = [...proximas, ...realizadas].map((actividad) => ({
  actividad,
  estado: (actividadEsProxima(actividad.data, ahora) ? 'proxima' : 'pasada') as EstadoActividad,
}));

// Tipos presentes en la Agenda, en el orden del esquema (para el Select de Tipo).
const presentes = new Set(todas.map((a) => a.actividad.data.tipo));
const tipos = (Object.keys(TIPOS_ACTIVIDAD) as (keyof typeof TIPOS_ACTIVIDAD)[]).filter((t) => presentes.has(t));

const textoDe = (a: (typeof todas)[number]) => normalizar(`${a.actividad.data.titulo} ${a.actividad.data.lugar ?? ''}`);
const conteoInicial = contarAgenda(
  todas.map((a) => ({ texto: textoDe(a), tipo: a.actividad.data.tipo, estado: a.estado })),
  { texto: '', tipo: TODAS },
);
---
<Base titulo="Agenda" descripcion="Actividades de la comunidad de Bioingeniería UdeC: seminarios, charlas, congresos y más.">
  <Fragment slot="head">
    <link rel="alternate" type="application/rss+xml" title="Agenda de BIOING+" href="/agenda/rss.xml" />
  </Fragment>
  <section id="agenda-listado" class="mx-auto max-w-6xl px-4 py-12" aria-labelledby="agenda-titulo">
    <h1 id="agenda-titulo" data-animar="fade-up" class="text-4xl font-semibold tracking-tight">Agenda</h1>
    <p class="mt-2 text-muted-foreground">Actividades de la comunidad de Bioingeniería UdeC.</p>

    <div class="mt-8 flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Vista de la agenda">
        <button type="button" data-estado-filtro="todas" aria-pressed="true" class="chip-pestana">Todos (<span data-conteo="todas">{conteoInicial.todas}</span>)</button>
        <button type="button" data-estado-filtro="proxima" aria-pressed="false" class="chip-pestana">Próximos (<span data-conteo="proximas">{conteoInicial.proximas}</span>)</button>
        <button type="button" data-estado-filtro="pasada" aria-pressed="false" class="chip-pestana">Pasados (<span data-conteo="pasadas">{conteoInicial.pasadas}</span>)</button>
      </div>

      <form id="filtros" class="flex w-full flex-col gap-4 md:flex-1 md:flex-row md:flex-wrap md:items-end" role="search">
        <div class="grid gap-2 md:min-w-64 md:flex-1">
          <Label for="texto">Buscar</Label>
          <Input id="texto" name="texto" type="search" placeholder="Nombre o lugar de la actividad" autocomplete="off" />
        </div>
        <FiltrosPlegables id="filtros-agenda-mas" neutros={[TODAS]} columnas={1}>
          <div class="grid gap-2">
            <Label id="etiqueta-tipo" for="tipo">Tipo</Label>
            <Select id="tipo" name="tipo" defaultValue={TODAS}>
              <SelectTrigger class="w-full" aria-labelledby="etiqueta-tipo"><SelectValue placeholder="Todos" /></SelectTrigger>
              <SelectContent>
                <SelectItem value={TODAS}>Todos</SelectItem>
                {tipos.map((t) => <SelectItem value={t}>{TIPOS_ACTIVIDAD[t]}</SelectItem>)}
              </SelectContent>
            </Select>
          </div>
        </FiltrosPlegables>
      </form>
    </div>

    <h2 class="sr-only">Resultados</h2>
    <ul role="list" id="lista" data-animar="grilla" class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {todas.map(({ actividad, estado }) => (
        <li data-texto={textoDe({ actividad, estado })} data-tipo={actividad.data.tipo} data-estado={estado}>
          <TarjetaActividad actividad={actividad} />
        </li>
      ))}
    </ul>

    <p id="sin-resultados" class="mt-10 hidden text-center text-muted-foreground">No hay actividades que coincidan con los filtros.</p>
  </section>
</Base>

<style>
  .chip-pestana {
    border: 1px solid var(--border);
    border-radius: 9999px;
    padding: 0.375rem 1rem;
    font-size: 0.875rem;
  }
  .chip-pestana:hover { background: var(--muted); }
  .chip-pestana[aria-pressed='true'] { background: var(--primary); border-color: var(--primary); color: var(--primary-foreground); }
  .chip-pestana:focus-visible { outline: 2px solid var(--outline); outline-offset: 2px; }
</style>

<script>
  import { coincideActividad, contarAgenda, TODAS, type EstadoActividad } from '@/lib/filtro-agenda';
  import { sincronizarFiltrosEnUrl } from '@/scripts/url-filtros';

  document.addEventListener('astro:page-load', () => {
    // El listener queda registrado en todas las navegaciones: solo actúa en su propio listado.
    if (location.pathname.replace(/\/$/, '') !== '/agenda') return;
    const form = document.querySelector<HTMLFormElement>('#filtros')!;
    const texto = document.querySelector<HTMLInputElement>('#texto')!;
    const items = [...document.querySelectorAll<HTMLLIElement>('#lista > li')];
    const pestanas = [...document.querySelectorAll<HTMLButtonElement>('[data-estado-filtro]')];
    const sinResultados = document.querySelector('#sin-resultados')!;
    let estado: EstadoActividad | typeof TODAS = TODAS;

    const datosDe = (li: HTMLLIElement) => ({
      texto: li.dataset.texto ?? '',
      tipo: li.dataset.tipo ?? '',
      estado: (li.dataset.estado ?? 'pasada') as EstadoActividad,
    });

    function aplicar() {
      const tipo = (new FormData(form).get('tipo') as string | null) || TODAS;
      let visibles = 0;
      for (const li of items) {
        const ok = coincideActividad(datosDe(li), { texto: texto.value, tipo, estado });
        li.hidden = !ok;
        if (ok) visibles++;
      }
      const conteo = contarAgenda(items.map(datosDe), { texto: texto.value, tipo });
      for (const span of [...document.querySelectorAll<HTMLElement>('[data-conteo]')]) {
        span.textContent = String(conteo[span.dataset.conteo as keyof typeof conteo]);
      }
      sinResultados.classList.toggle('hidden', !(items.length > 0 && visibles === 0));
      for (const p of pestanas) p.setAttribute('aria-pressed', String(p.dataset.estadoFiltro === estado));

      // Los filtros quedan en la URL para compartir el listado filtrado.
      sincronizarFiltrosEnUrl({ q: texto.value, tipo, vista: estado === TODAS ? '' : estado }, [TODAS]);
    }

    // Estado inicial desde la URL (p. ej. /agenda?tipo=seminario&vista=proxima).
    const params = new URLSearchParams(location.search);
    texto.value = params.get('q') ?? '';
    if (params.get('vista') === 'proxima' || params.get('vista') === 'pasada') estado = params.get('vista')! as EstadoActividad;
    if (params.get('tipo')) {
      document.querySelector('#tipo')?.dispatchEvent(new CustomEvent('starwind:set-value', { detail: { value: params.get('tipo') } }));
    }

    for (const p of pestanas) {
      p.addEventListener('click', () => {
        const valor = p.dataset.estadoFiltro ?? TODAS;
        estado = valor === 'proxima' || valor === 'pasada' ? valor : TODAS;
        aplicar();
      });
    }
    form.addEventListener('input', () => aplicar());
    form.addEventListener('change', () => aplicar());
    // Starwind v3: el Select emite starwind:value-change antes de fijar el valor.
    form.addEventListener('starwind:value-change', () => setTimeout(aplicar, 0));
    setTimeout(() => aplicar(), 0);
  });
</script>