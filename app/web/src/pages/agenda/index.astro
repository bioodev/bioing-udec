---
import Base from '@/layouts/Base.astro';
import TarjetaActividad from '@/components/TarjetaActividad.astro';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
import { actividadesRealizadas, proximasActividades } from '@/lib/contenido';
import { normalizar } from '@/lib/reglas';
import { TIPOS_ACTIVIDAD } from '@/lib/agenda';
import { TODAS } from '@/lib/filtro-agenda';

const proximas = await proximasActividades();
const realizadas = await actividadesRealizadas();

const secciones = [
  { id: 'proximas', titulo: 'Próximas actividades', items: proximas, vacio: 'No hay actividades próximas por ahora.' },
  { id: 'realizadas', titulo: 'Actividades realizadas', items: realizadas, vacio: 'Aún no hay actividades en el archivo.' },
];

// Tipos presentes en la Agenda, en el orden del esquema (para los botones de filtro).
const presentes = new Set([...proximas, ...realizadas].map((a) => a.data.tipo));
const tipos = (Object.keys(TIPOS_ACTIVIDAD) as (keyof typeof TIPOS_ACTIVIDAD)[]).filter((t) => presentes.has(t));

const total = proximas.length + realizadas.length;
const textoDe = (a: (typeof proximas)[number]) => normalizar(`${a.data.titulo} ${a.data.lugar ?? ''}`);
---
<Base titulo="Agenda" descripcion="Actividades de la comunidad de Bioingeniería UdeC: seminarios, charlas, congresos y más.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-4xl font-semibold tracking-tight">Agenda</h1>
    <p class="mt-2 text-muted-foreground">Actividades de la comunidad de Bioingeniería UdeC.</p>

    <form id="filtros" class="mt-8 max-w-md" role="search" onsubmit="return false">
      <div class="grid gap-2">
        <Label for="texto">Buscar</Label>
        <Input id="texto" name="texto" type="search" placeholder="Nombre o lugar de la actividad" autocomplete="off" />
      </div>
    </form>

    <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="Filtrar por tipo de actividad">
      <button type="button" data-tipo={TODAS} aria-pressed="true" class="chip-tipo">Todas</button>
      {tipos.map((t) => <button type="button" data-tipo={t} aria-pressed="false" class="chip-tipo">{TIPOS_ACTIVIDAD[t]}</button>)}
    </div>

    <p id="contador" class="mt-6 text-sm text-muted-foreground" aria-live="polite">{total === 1 ? '1 actividad' : `${total} actividades`}</p>

    {secciones.map((s) => (
      <section data-seccion id={s.id} class="mt-10" aria-labelledby={`${s.id}-titulo`}>
        <h2 id={`${s.id}-titulo`} class="text-2xl font-semibold tracking-tight">{s.titulo}</h2>
        <ul class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {s.items.map((a) => (
            <li data-texto={textoDe(a)} data-tipo={a.data.tipo}>
              <TarjetaActividad actividad={a} />
            </li>
          ))}
        </ul>
        <p data-vacio class="mt-6 hidden text-muted-foreground">{s.vacio}</p>
      </section>
    ))}

    <p id="sin-resultados" class="mt-10 hidden text-center text-muted-foreground">No hay actividades que coincidan con los filtros.</p>
  </section>
</Base>

<style>
  .chip-tipo {
    border: 1px solid var(--border);
    border-radius: 9999px;
    padding: 0.25rem 0.875rem;
    font-size: 0.875rem;
  }
  .chip-tipo:hover { background: var(--muted); }
  .chip-tipo[aria-pressed='true'] { background: var(--primary); border-color: var(--primary); color: var(--primary-foreground); }
  .chip-tipo:focus-visible { outline: 2px solid var(--outline); outline-offset: 2px; }
</style>

<script>
  import { coincideActividad, TODAS } from '@/lib/filtro-agenda';

  const form = document.querySelector<HTMLFormElement>('#filtros')!;
  const texto = document.querySelector<HTMLInputElement>('#texto')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip-tipo')];
  const items = [...document.querySelectorAll<HTMLLIElement>('[data-seccion] li')];
  const secciones = [...document.querySelectorAll<HTMLElement>('[data-seccion]')];
  const contador = document.querySelector('#contador')!;
  const sinResultados = document.querySelector('#sin-resultados')!;
  let tipo = TODAS;

  function aplicar() {
    const f = { texto: texto.value, tipo };
    let visibles = 0;
    for (const li of items) {
      const coincide = coincideActividad({ texto: li.dataset.texto ?? '', tipo: li.dataset.tipo ?? '' }, f);
      li.hidden = !coincide;
      if (coincide) visibles++;
    }
    for (const s of secciones) {
      const lis = [...s.querySelectorAll<HTMLLIElement>('li')];
      const vacio = s.querySelector<HTMLElement>('[data-vacio]')!;
      if (lis.length > 0) s.hidden = lis.every((li) => li.hidden);
      vacio.classList.toggle('hidden', lis.length > 0);
    }

    contador.textContent = visibles === 1 ? '1 actividad' : `${visibles} actividades`;
    // "Sin filtros" solo cuando hay actividades pero ninguna coincide; sin actividades, lo dice cada sección.
    sinResultados.classList.toggle('hidden', !(items.length > 0 && visibles === 0));
    for (const c of chips) c.setAttribute('aria-pressed', String(c.dataset.tipo === tipo));

    // Los filtros quedan en la URL para compartir el listado filtrado.
    const url = new URL(location.href);
    for (const [k, v] of Object.entries({ q: texto.value, tipo })) {
      if (v && v !== TODAS) url.searchParams.set(k, v); else url.searchParams.delete(k);
    }
    history.replaceState(null, '', url);
  }

  // Estado inicial desde la URL (p. ej. /agenda?tipo=seminario).
  const params = new URLSearchParams(location.search);
  texto.value = params.get('q') ?? '';
  if (params.get('tipo') && chips.some((c) => c.dataset.tipo === params.get('tipo'))) tipo = params.get('tipo')!;

  for (const c of chips) c.addEventListener('click', () => { tipo = c.dataset.tipo ?? TODAS; aplicar(); });
  form.addEventListener('input', () => aplicar());
  form.addEventListener('change', () => aplicar());
  aplicar();
</script>
