---
import Base from '@/layouts/Base.astro';
import PublicacionInstagram from '@/components/PublicacionInstagram.astro';
import ArrowSquareOut from 'phosphor-astro/ArrowSquareOut.astro';
import { configuracionRedes, descripcionDeListado, imagenDeListadoSeo, publicacionesInstagram } from '@/lib/contenido';

const publicaciones = await publicacionesInstagram();
// El enlace «Seguir» sale de la red Instagram del panel (src/content/redes); si está vacía, no hay botón.
const urlInstagram = (await configuracionRedes()).instagram;
const descripcion = await descripcionDeListado('instagram');
const imagenListado = await imagenDeListadoSeo('instagram');
---
<Base titulo="Instagram" descripcion={descripcion} imagen={imagenListado}>
  <section id="instagram-listado" class="mx-auto max-w-6xl px-4 py-12" aria-labelledby="instagram-titulo">
    <h1 id="instagram-titulo" data-animar="fade-up" class="text-4xl font-semibold tracking-tight">Instagram</h1>
    <p class="mt-2 text-muted-foreground">Publicaciones seleccionadas de la cuenta de Bioingeniería UdeC.</p>
    {urlInstagram && (
      <p class="mt-2">
        <a href={urlInstagram} target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-primary hover:underline">Seguir en Instagram <ArrowSquareOut class="size-4" aria-hidden="true" /></a>
      </p>
    )}

    {publicaciones.length > 0 ? (
      <>
        <h2 class="sr-only">Publicaciones seleccionadas</h2>
        <div data-animar="grilla" class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {publicaciones.map((p) => <PublicacionInstagram publicacion={p} />)}
        </div>
      </>
    ) : (
      <p class="mt-8 text-muted-foreground">Aún no hay publicaciones seleccionadas.</p>
    )}
  </section>
</Base>
