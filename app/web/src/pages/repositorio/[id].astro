---
import { resolverSeo } from '@/lib/seo';
import { getEntries, type CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Distintivo from '@/components/Distintivo.astro';
import { Button } from '@/components/starwind/button';
import { documentosDelRepositorio, seoDeEntrada } from '@/lib/contenido';
import { existentes } from '@/lib/reglas';
import { TIPOS_DOCUMENTO } from '@/lib/repositorio';
import { vistaPreviaDrive } from '@/lib/enlaces';
import { migas, documento as jsonLdDocumento } from '@/lib/schema';
import ArrowLeft from 'phosphor-astro/ArrowLeft.astro';
import ArrowSquareOut from 'phosphor-astro/ArrowSquareOut.astro';

export async function getStaticPaths() {
  const documentos = await documentosDelRepositorio();
  return documentos.map((documento) => ({ params: { id: documento.id }, props: { documento } }));
}

interface Props { documento: CollectionEntry<'documentos'> }
const { documento } = Astro.props;
// existentes(): una referencia a un Tema o Área borrado se descarta en vez de romper el build.
const temas = existentes(await getEntries(documento.data.temas ?? []));
const areas = existentes(await getEntries(documento.data.areas ?? []));
const vista = vistaPreviaDrive(documento.data.enlace);

const enlace = `/repositorio/${documento.id}`;
const jsonLdPagina = [
  migas(
    [
      { name: 'Inicio', url: '/' },
      { name: 'Repositorio', url: '/repositorio' },
      { name: documento.data.titulo, url: enlace },
    ],
    Astro.site,
  ),
  jsonLdDocumento(documento, { site: Astro.site, url: enlace, temas: temas.map((t) => t.data.nombre) }),
];
const seo = resolverSeo({ titulo: documento.data.titulo, descripcion: `${TIPOS_DOCUMENTO[documento.data.tipo]} · ${documento.data.titulo}` }, seoDeEntrada(documento.data.seo));
---
<Base titulo={seo.titulo} descripcion={seo.descripcion} imagen={seo.imagen} noindex={seo.noindex} jsonLd={jsonLdPagina}>
  <article class="mx-auto max-w-3xl px-4 py-12">
    <div class="flex flex-wrap items-center gap-2">
      <Distintivo clase="tipo">{TIPOS_DOCUMENTO[documento.data.tipo]}</Distintivo>
      <span class="text-sm text-muted-foreground">{documento.data.anio}</span>
    </div>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight">{documento.data.titulo}</h1>
    {documento.data.descripcion && <p class="mt-4 text-xl text-muted-foreground">{documento.data.descripcion}</p>}

    {(temas.length > 0 || areas.length > 0) && (
      <dl class="mt-6 grid gap-2 text-sm">
        {temas.length > 0 && <div><dt class="inline text-muted-foreground">Temas: </dt><dd class="inline">{temas.map((t) => t.data.nombre).join(' · ')}</dd></div>}
        {areas.length > 0 && <div><dt class="inline text-muted-foreground">Áreas: </dt><dd class="inline">{areas.map((a) => a.data.nombre).join(' · ')}</dd></div>}
      </dl>
    )}

    {documento.data.palabras_clave && documento.data.palabras_clave.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {documento.data.palabras_clave.map((p) => <Distintivo clase="clave">{p}</Distintivo>)}
      </div>
    )}

    {vista && (
      <iframe src={vista} title={`Vista previa: ${documento.data.titulo}`} loading="lazy" class="mt-8 aspect-[3/4] w-full rounded-lg border border-border md:aspect-[4/3]" allow="autoplay"></iframe>
    )}

    <p class="mt-6">
      <Button as="a" href={documento.data.enlace} target="_blank" rel="noopener" class="rounded-full">
        Abrir documento<ArrowSquareOut class="size-4" aria-hidden="true" />
      </Button>
    </p>
    <p class="mt-2 text-sm text-muted-foreground">Si la vista previa no carga, abre el documento en una pestaña nueva.</p>

    <p class="mt-10 border-t border-border pt-6 text-sm"><a href="/repositorio" class="inline-flex items-center gap-1 text-primary hover:underline"><ArrowLeft class="size-4" aria-hidden="true" /> Volver al Repositorio</a></p>
  </article>
</Base>
