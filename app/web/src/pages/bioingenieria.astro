---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import VideoModal from '@/components/VideoModal.astro';
import ArrowRight from 'phosphor-astro/ArrowRight.astro';
import ArrowUpRight from 'phosphor-astro/ArrowUpRight.astro';
import { pagina } from '@/lib/contenido';
import { idYouTube } from '@/lib/enlaces';
import { URL_FCB } from '@/lib/navegacion';

const entrada = await pagina('bioingenieria');
const { Content } = await render(entrada);
const video = entrada.data.video ? idYouTube(entrada.data.video) : null;
const caracteristicas = entrada.data.caracteristicas ?? [];
---
<Base titulo={entrada.data.titulo} descripcion={entrada.data.bajada}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{entrada.data.titulo}</h1>
    <p class="mt-4 max-w-3xl text-xl text-muted-foreground">{entrada.data.bajada}</p>
    {video && (
      <div class="mt-10 max-w-4xl">
        <VideoModal id={video} titulo="Video institucional de Bioingeniería UdeC" />
      </div>
    )}
  </section>

  <section class="bg-muted">
    <div class="mx-auto max-w-3xl px-4 py-16">
      <div class="prose max-w-none"><Content /></div>
    </div>
  </section>

  {caracteristicas.length > 0 && (
    <section class="bg-foreground text-background">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <h2 class="text-3xl font-semibold tracking-tight">Características de la carrera</h2>
        <div class="mt-8 grid gap-8 md:grid-cols-2">
          {caracteristicas.map((c) => (
            <div>
              <h3 class="text-xl font-semibold">{c.titulo}</h3>
              <p class="mt-2 opacity-80">{c.texto}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="flex flex-wrap gap-4">
      <a href="/directorio" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-2 text-primary-foreground hover:opacity-90">Conoce a los egresados/as <ArrowRight class="size-4" aria-hidden="true" /></a>
      <a href={URL_FCB} class="inline-flex items-center gap-2 rounded-full border border-primary px-6 py-2 text-primary hover:bg-primary/5">Facultad de Ciencias Biológicas <ArrowUpRight class="size-4" aria-hidden="true" /></a>
    </div>
  </section>
</Base>
