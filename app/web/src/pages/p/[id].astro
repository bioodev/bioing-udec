---
// Página libre: texto creado desde el panel (src/content/paginas-libres). Solo las publicadas tienen ruta.
import { render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Migas from '@/components/Migas.astro';
import VideoModal from '@/components/VideoModal.astro';
import Incrustados from '@/components/Incrustados.astro';
import Enlaces from '@/components/Enlaces.astro';
import { paginasLibres } from '@/lib/contenido';
import { idYouTube } from '@/lib/enlaces';
import { migas } from '@/lib/schema';

export async function getStaticPaths() {
  const paginas = await paginasLibres();
  return paginas.map((pagina) => ({ params: { id: pagina.id }, props: { pagina } }));
}

interface Props { pagina: CollectionEntry<'paginasLibres'> }
const { pagina } = Astro.props;
const { Content } = await render(pagina);

const enlace = `/p/${pagina.id}`;
const rutas = [
  { name: 'Inicio', url: '/' },
  { name: pagina.data.titulo, url: enlace },
];
const video = pagina.data.video ? idYouTube(pagina.data.video) : null;
const bloques = pagina.data.bloques ?? [];
// Con video o bloques, la página usa el diseño de «¿Qué es la Bioingeniería?»: cabecera ancha, cuerpo sobre
// fondo gris y franja oscura. Sin ninguno, queda la columna de texto de siempre.
const conDiseno = video !== null || bloques.length > 0;
---
<Base titulo={pagina.data.titulo} descripcion={pagina.data.bajada} imagen={pagina.data.imagen?.src} jsonLd={migas(rutas, Astro.site)}>
  {conDiseno ? (
    <>
      <section id="pagina-cabecera" class="mx-auto max-w-6xl px-4 py-16">
        <Migas items={rutas} />
        <h1 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl">{pagina.data.titulo}</h1>
        <p class="mt-4 max-w-3xl text-xl text-muted-foreground">{pagina.data.bajada}</p>
        <Enlaces items={pagina.data.enlaces ?? []} />
        {video && (
          <div class="mt-10 max-w-4xl">
            <VideoModal id={video} titulo={`Video: ${pagina.data.titulo}`} />
          </div>
        )}
        {pagina.data.imagen && <Image src={pagina.data.imagen} alt={pagina.data.imagen_alt ?? ''} class="mt-10 aspect-video w-full max-w-4xl rounded-lg object-cover" widths={[768, 1536]} sizes="(min-width: 768px) 768px, 100vw" />}
      </section>

      <section id="pagina-contenido" class="bg-muted">
        <div class="mx-auto max-w-3xl px-4 py-16">
          <div class="prose max-w-none"><Content /></div>
          <Incrustados items={pagina.data.incrustados ?? []} />
        </div>
      </section>

      {bloques.length > 0 && (
        <section id="pagina-bloques" class="bg-foreground text-background">
          <div class="mx-auto max-w-6xl px-4 py-16">
            {pagina.data.bloques_titulo && <h2 class="text-3xl font-semibold tracking-tight">{pagina.data.bloques_titulo}</h2>}
            <div class="mt-8 grid gap-8 md:grid-cols-2">
              {bloques.map((b) => (
                <div>
                  <h3 class="text-xl font-semibold">{b.titulo}</h3>
                  <p class="mt-2 opacity-80">{b.texto}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )}
    </>
  ) : (
    <article class="mx-auto w-full max-w-3xl px-4 py-12">
      <header>
        <Migas items={rutas} />
        <h1 class="mt-6 text-4xl font-semibold tracking-tight">{pagina.data.titulo}</h1>
        <p class="mt-4 text-xl text-muted-foreground">{pagina.data.bajada}</p>
        <Enlaces items={pagina.data.enlaces ?? []} />
        {pagina.data.imagen && <Image src={pagina.data.imagen} alt={pagina.data.imagen_alt ?? ''} class="mt-8 aspect-video w-full rounded-lg object-cover" widths={[768, 1536]} sizes="(min-width: 768px) 768px, 100vw" />}
      </header>

      <div class="prose mt-8 max-w-none"><Content /></div>
      <Incrustados items={pagina.data.incrustados ?? []} />
    </article>
  )}
</Base>
