---
import { getCollection, getEntries, getEntry, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import TarjetaNoticia from '@/components/TarjetaNoticia.astro';
import TarjetaActividad from '@/components/TarjetaActividad.astro';
import TarjetaAnuncio from '@/components/TarjetaAnuncio.astro';
import { configuracionMenu, vinculosDe } from '@/lib/contenido';
import { seccionActiva } from '@/lib/navegacion';
import { existentes } from '@/lib/reglas';
import { migas, persona as jsonLdPersona } from '@/lib/schema';
import LinkedinLogo from 'phosphor-astro/LinkedinLogo.astro';
import LinkSimple from 'phosphor-astro/Link.astro';

export async function getStaticPaths() {
  const personas = await getCollection('personas', ({ data }) => data.ficha_activa);
  return personas.map((persona) => ({ params: { id: persona.id }, props: { persona } }));
}

interface Props { persona: CollectionEntry<'personas'> }
const { persona } = Astro.props;
const perfil = persona.data.perfil_egresado?.autorizado ? persona.data.perfil_egresado : undefined;
const organizacion = perfil?.organizacion ? await getEntry(perfil.organizacion) : undefined;
const areas = perfil?.areas ? existentes(await getEntries(perfil.areas)) : [];
const { noticias, organiza, expone, ofrece } = await vinculosDe('personas', persona.id);

const enlace = `/personas/${persona.id}`;
// La ficha sigue existiendo aunque el Directorio esté apagado: la migaja solo lleva al Directorio si está activo.
const configMenu = await configuracionMenu();
const jsonLdPagina = [
  migas(
    [
      { name: 'Inicio', url: '/' },
      ...(seccionActiva('/directorio', configMenu) ? [{ name: 'Directorio', url: '/directorio' }] : []),
      { name: persona.data.nombre, url: enlace },
    ],
    Astro.site,
  ),
  jsonLdPersona(persona, {
    site: Astro.site,
    url: enlace,
    organizacion: organizacion
      ? { nombre: organizacion.data.nombre, ...(organizacion.data.sitio_web ? { sitioWeb: organizacion.data.sitio_web } : {}) }
      : undefined,
  }),
];
---
<Base titulo={persona.data.nombre} jsonLd={jsonLdPagina}>
  <section id="persona-ficha" class="bg-muted" aria-labelledby="persona-titulo">
    <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-12 sm:flex-row sm:items-center">
      {persona.data.foto
        ? <Image src={persona.data.foto} alt={persona.data.nombre} width={160} height={160} class="h-40 w-40 rounded-full object-cover" />
        : <div class="flex h-40 w-40 items-center justify-center rounded-full bg-background text-5xl font-semibold text-muted-foreground" aria-hidden="true">{persona.data.nombre.charAt(0)}</div>}
      <div>
        <h1 id="persona-titulo" class="text-4xl font-semibold tracking-tight">{persona.data.nombre}</h1>
        {persona.data.descripcion && <p class="mt-2 text-lg text-muted-foreground">{persona.data.descripcion}</p>}
        {perfil && (
          <dl class="mt-4 grid gap-1 text-sm">
            {perfil.cargo && <div><dt class="inline text-muted-foreground">Cargo: </dt><dd class="inline">{perfil.cargo}{organizacion && ` · ${organizacion.data.nombre}`}</dd></div>}
            <div><dt class="inline text-muted-foreground">Egreso: </dt><dd class="inline">{perfil.anio_egreso}{perfil.generacion && ` (generación ${perfil.generacion})`}</dd></div>
            {areas.length > 0 && <div><dt class="inline text-muted-foreground">Áreas: </dt><dd class="inline">{areas.map((a) => a.data.nombre).join(', ')}</dd></div>}
            {perfil.enlaces?.map((e) => {
              const Icono = /linkedin\.com/.test(e.url) ? LinkedinLogo : LinkSimple;
              return <div><dd><a href={e.url} class="inline-flex items-center gap-1.5 text-primary hover:underline" rel="noopener" target="_blank"><Icono class="size-4" aria-hidden="true" />{e.etiqueta}</a></dd></div>;
            })}
          </dl>
        )}
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-12 grid gap-12">
    {expone.length > 0 && <section id="persona-expone" aria-labelledby="persona-expone-titulo"><h2 id="persona-expone-titulo" class="text-2xl font-semibold">Expuso en</h2><ul role="list" class="mt-6 grid gap-6 md:grid-cols-3">{expone.map((a) => <li><TarjetaActividad actividad={a} sinId /></li>)}</ul></section>}
    {organiza.length > 0 && <section id="persona-organiza" aria-labelledby="persona-organiza-titulo"><h2 id="persona-organiza-titulo" class="text-2xl font-semibold">Organizó</h2><ul role="list" class="mt-6 grid gap-6 md:grid-cols-3">{organiza.map((a) => <li><TarjetaActividad actividad={a} sinId /></li>)}</ul></section>}
    {noticias.length > 0 && <section id="persona-noticias" aria-labelledby="persona-noticias-titulo"><h2 id="persona-noticias-titulo" class="text-2xl font-semibold">Noticias</h2><ul role="list" class="mt-6 grid gap-6 md:grid-cols-3">{noticias.map((n) => <li><TarjetaNoticia noticia={n} /></li>)}</ul></section>}
    {ofrece.length > 0 && <section id="persona-oportunidades" aria-labelledby="persona-oportunidades-titulo"><h2 id="persona-oportunidades-titulo" class="text-2xl font-semibold">Oportunidades que ofrece</h2><ul role="list" class="mt-6 grid gap-6 md:grid-cols-3">{ofrece.map((a) => <li><TarjetaAnuncio anuncio={a} /></li>)}</ul></section>}
  </div>
</Base>
