---
import Base from '@/layouts/Base.astro';
---
<Base titulo="Buscar" descripcion="Buscador del sitio BIOING+: noticias, actividades, anuncios, documentos, personas y organizaciones.">
  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  </Fragment>
  <section class="mx-auto max-w-3xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight">Buscar en BIOING+</h1>
    <p class="mt-2 text-muted-foreground">Encuentra noticias, actividades, anuncios, documentos, personas y organizaciones de la comunidad.</p>
    <div id="pagefind" data-pagefind-ignore class="mt-8"></div>
  </section>
</Base>

<style is:global>
  /* Estilos acordes a DESIGN.md: acento azul único, bordes suaves, tipografía del tema. */
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #0066cc;
    --pagefind-ui-text: #1d1d1f;
    --pagefind-ui-border: #e0e0e0;
    --pagefind-ui-tag: #f5f5f7;
    --pagefind-ui-background: #ffffff;
  }
  .pagefind-ui__search-input {
    border: 1px solid var(--pagefind-ui-border);
    border-radius: 9999px;
    padding: 0.625rem 1rem 0.625rem 2.75rem;
  }
  .pagefind-ui__search-input::placeholder { color: #7a7a7a; }
  .pagefind-ui__search-input:focus {
    outline: 2px solid #0071e3;
    outline-offset: 2px;
  }
  .pagefind-ui__result-title a:hover { text-decoration: underline; }
</style>

<!-- pagefind-ui.js se genera en el postbuild (dist/pagefind/); is:inline evita que Astro lo bundlee. -->
<script is:inline src="/pagefind/pagefind-ui.js"></script>
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (!window.PagefindUI) return;
    new window.PagefindUI({ element: '#pagefind', showSubResults: true });
    // Accesibilidad: anuncia los cambios en el conteo de resultados (aria-live).
    const raiz = document.querySelector('#pagefind');
    const observer = new MutationObserver(() => {
      const conteo = raiz?.querySelector('.pagefind-ui__result-count');
      if (conteo && !conteo.hasAttribute('aria-live')) conteo.setAttribute('aria-live', 'polite');
    });
    observer.observe(raiz, { childList: true, subtree: true });
  });
</script>