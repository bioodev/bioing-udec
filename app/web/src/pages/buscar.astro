---
import Base from '@/layouts/Base.astro';
import ArrowLeft from 'phosphor-astro/ArrowLeft.astro';
---
<Base titulo="Buscar" descripcion="Buscador del sitio BIOING+: noticias, actividades, anuncios, documentos, personas y organizaciones.">
  <Fragment slot="head">
    {import.meta.env.PROD && <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />}
  </Fragment>
  <section id="buscar" aria-labelledby="buscar-titulo" class="mx-auto max-w-3xl px-4 py-12">
    <!-- Sin JS vuelve a la portada; con JS, scripts/buscador.ts usa history.back() si hay de dónde volver. -->
    <a href="/" data-volver class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-primary">
      <ArrowLeft class="size-4" aria-hidden="true" />Volver
    </a>
    <h1 id="buscar-titulo" class="text-3xl font-semibold tracking-tight">Buscar en BIOING+</h1>
    <p class="mt-2 text-muted-foreground">Encuentra noticias, actividades, anuncios, documentos, personas y organizaciones de la comunidad.</p>
    <div id="pagefind" data-pagefind-ignore class="mt-8"></div>
  </section>
</Base>

<style is:global>
  /* Estilos acordes a DESIGN.md: acento azul único, bordes suaves, tipografía del tema. */
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #0066cc;
    --pagefind-ui-text: #1d1d1f;
    --pagefind-ui-border: #e0e0e0;
    --pagefind-ui-tag: #f5f5f7;
    --pagefind-ui-background: #ffffff;
  }
  .pagefind-ui__search-input {
    border: 1px solid var(--pagefind-ui-border);
    border-radius: 9999px;
    padding: 0.625rem 1rem 0.625rem 2.75rem;
  }
  .pagefind-ui__search-input::placeholder { color: #7a7a7a; }
  .pagefind-ui__search-input:focus {
    outline: 2px solid #0071e3;
    outline-offset: 2px;
  }
  .pagefind-ui__result-title a:hover { text-decoration: underline; }
</style>

<!-- pagefind-ui.js se genera en el postbuild (dist/pagefind/); solo existe en el build (en dev no hay índice). is:inline evita que Astro lo bundlee. -->
{import.meta.env.PROD && <script is:inline src="/pagefind/pagefind-ui.js"></script>}
<script is:inline>
  // ClientRouter reemplaza el DOM al navegar y este script no se vuelve a ejecutar: el buscador
  // se inicia en cada astro:page-load (también en la carga directa). La marca data-iniciado vive
  // en el contenedor, que es nuevo en cada página, así que no se duplica la UI.
  const enBuscar = () => /^\/buscar\/?$/.test(location.pathname);
  function iniciarBuscador() {
    const raiz = document.querySelector('#pagefind');
    if (!enBuscar() || !raiz || raiz.hasAttribute('data-iniciado') || !window.PagefindUI) return;
    raiz.setAttribute('data-iniciado', '');
    new window.PagefindUI({ element: '#pagefind', showSubResults: true });
    // Accesibilidad: anuncia los cambios en el conteo de resultados (aria-live).
    const observer = new MutationObserver(() => {
      const mensaje = raiz.querySelector('.pagefind-ui__message, .pagefind-ui__result-count');
      if (mensaje && !mensaje.hasAttribute('aria-live')) mensaje.setAttribute('aria-live', 'polite');
    });
    // childList+subtree+characterData: Pagefind actualiza el texto del mensaje en su
    // render de Svelte; el observador reaplica aria-live si el nodo se recrea.
    observer.observe(raiz, { childList: true, subtree: true, characterData: true });
  }
  document.addEventListener('astro:page-load', iniciarBuscador);
  if (document.readyState === 'loading') window.addEventListener('DOMContentLoaded', iniciarBuscador);
  else iniciarBuscador();
</script>