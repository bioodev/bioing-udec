---
import Base from '@/layouts/Base.astro';
import HeroCarrusel from '@/components/HeroCarrusel.astro';
import TarjetaNoticia from '@/components/TarjetaNoticia.astro';
import TarjetaActividad from '@/components/TarjetaActividad.astro';
import TarjetaAnuncio from '@/components/TarjetaAnuncio.astro';
import PublicacionInstagram from '@/components/PublicacionInstagram.astro';
import SeccionDestacada from '@/components/SeccionDestacada.astro';
import BandaComunidad from '@/components/BandaComunidad.astro';
import PaginaDestacada from '@/components/PaginaDestacada.astro';
import ArrowRight from 'phosphor-astro/ArrowRight.astro';
import { anunciosVigentes, bandaComunidad, configuracionMenu, descripcionDeListado, imagenDeListadoSeo, noticiasRecientes, paginaDestacadaInicio, proximasActividades, publicacionesInstagram, publicados, seccionesInicio } from '@/lib/contenido';
import { enlaceDisponible, seccionActiva } from '@/lib/navegacion';
import { estaVigente } from '@/lib/reglas';
import { getImage } from 'astro:assets';

// Secciones que el panel apagó (src/content/menu/menu.yml): no se muestran en el Inicio ni sus bloques.
const configMenu = await configuracionMenu();

// Banners vigentes: cada uno es un slide del hero en carrusel (wireframes: Inicio). Un Banner que lleva a una
// sección apagada no se muestra.
const banners = (await publicados('banners'))
  .filter((b) => estaVigente(b.data, new Date()) && enlaceDisponible(b.data.enlace, configMenu))
  .sort((a, b) => b.data.inicio.valueOf() - a.data.inicio.valueOf());

// Preload del LCP: la imagen del primer slide se pide en cuanto arranca el documento
// (el <Image priority> de HeroCarrusel ya va con fetchpriority=high; este <link> adelanta
// aún más el request de red). El resto de imágenes va con lazy por defecto (Astro).
const lcp = banners[0]
  ? await getImage({ src: banners[0].data.imagen, widths: [640, 1280, 1920], format: 'webp' }).catch(() => undefined)
  : undefined;

const secciones = (await seccionesInicio()).filter((s) => enlaceDisponible(s.enlace, configMenu));
const paginaDestacada = await paginaDestacadaInicio();
// Banda «Comunidad y documentos»: null si el panel apagó el Directorio y el Repositorio.
const banda = await bandaComunidad(configMenu);

const [noticias, actividades, anuncios, pubInstagram] = await Promise.all([
  noticiasRecientes(3), proximasActividades(), anunciosVigentes(), publicacionesInstagram(3),
]);
const descripcion = await descripcionDeListado('inicio');
const imagenListado = await imagenDeListadoSeo('inicio');
---
<Base titulo="BIOING+" descripcion={descripcion} imagen={imagenListado}>
  {lcp && (
    <link
      slot="head"
      rel="preload"
      as="image"
      href={lcp.src}
      imagesrcset={lcp.srcSet?.attribute}
      imagesizes="100vw"
      fetchpriority="high"
    />
  )}
  {banners.length > 0 && <HeroCarrusel banners={banners} />}
  {banners.length === 0 && <h1 class="sr-only">BIOING+</h1>}

  {paginaDestacada && <PaginaDestacada pagina={paginaDestacada} />}

  {noticias.length > 0 && (
    <section id="inicio-noticias" class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="inicio-noticias-titulo">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="inicio-noticias-titulo" data-animar="fade-up" class="text-3xl font-semibold tracking-tight">Noticias recientes</h2>
        <a data-animar="fade-up" href="/noticias" class="inline-flex items-center gap-1 text-sm text-primary hover:underline">Ver todas las noticias <ArrowRight class="size-4" aria-hidden="true" /></a>
      </div>
      <ul role="list" data-animar="grilla" class="mt-8 grid gap-6 md:grid-cols-3">{noticias.map((n) => <li><TarjetaNoticia noticia={n} /></li>)}</ul>
    </section>
  )}

  {actividades.length > 0 && (
    <section id="inicio-agenda" class="bg-muted" aria-labelledby="inicio-agenda-titulo">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="inicio-agenda-titulo" data-animar="fade-up" class="text-3xl font-semibold tracking-tight">Próximas actividades</h2>
          <a data-animar="fade-up" href="/agenda" class="inline-flex items-center gap-1 text-sm text-primary hover:underline">Ver todas las actividades <ArrowRight class="size-4" aria-hidden="true" /></a>
        </div>
        <ul role="list" data-animar="grilla" class="mt-8 grid gap-6 md:grid-cols-3">{actividades.slice(0, 3).map((a) => <li><TarjetaActividad actividad={a} /></li>)}</ul>
      </div>
    </section>
  )}

  {anuncios.length > 0 && seccionActiva('/anuncios', configMenu) && (
    <section id="inicio-anuncios" class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="inicio-anuncios-titulo">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="inicio-anuncios-titulo" data-animar="fade-up" class="text-3xl font-semibold tracking-tight">Anuncios</h2>
        <a data-animar="fade-up" href="/anuncios" class="inline-flex items-center gap-1 text-sm text-primary hover:underline">Ver todos los anuncios <ArrowRight class="size-4" aria-hidden="true" /></a>
      </div>
      <ul role="list" data-animar="grilla" class="mt-8 grid gap-6 md:grid-cols-3">{anuncios.slice(0, 3).map((a) => <li><TarjetaAnuncio anuncio={a} /></li>)}</ul>
    </section>
  )}

  {pubInstagram.length > 0 && seccionActiva('/instagram', configMenu) && (
    <section id="inicio-instagram" class="bg-muted" aria-labelledby="inicio-instagram-titulo">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 id="inicio-instagram-titulo" data-animar="fade-up" class="text-3xl font-semibold tracking-tight">En Instagram</h2>
          <a href="/instagram" class="inline-flex items-center gap-1 text-sm text-primary hover:underline">Ver más <ArrowRight class="size-4" aria-hidden="true" /></a>
        </div>
        <div data-animar="grilla" class="mt-8 grid gap-6 md:grid-cols-3">{pubInstagram.map((p) => <PublicacionInstagram publicacion={p} />)}</div>
      </div>
    </section>
  )}

  {banda && <BandaComunidad banda={banda} />}

  {secciones.map((seccion) => <SeccionDestacada seccion={seccion} />)}
</Base>

<script>
  import { iniciarParallax, limpiarParallax } from '@/scripts/parallax';

  // Los <script> corren una vez; el parallax se reinicia en cada página del Inicio (ClientRouter).
  document.addEventListener('astro:before-swap', limpiarParallax);
  document.addEventListener('astro:page-load', () => {
    if (location.pathname.replace(/\/$/, '') !== '') return;
    iniciarParallax();
  });
</script>
