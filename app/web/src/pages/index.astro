---
import Base from '@/layouts/Base.astro';
import HeroCarrusel from '@/components/HeroCarrusel.astro';
import TarjetaNoticia from '@/components/TarjetaNoticia.astro';
import TarjetaActividad from '@/components/TarjetaActividad.astro';
import TarjetaAnuncio from '@/components/TarjetaAnuncio.astro';
import PublicacionInstagram from '@/components/PublicacionInstagram.astro';
import ArrowRight from 'phosphor-astro/ArrowRight.astro';
import { anunciosVigentes, noticiasRecientes, proximasActividades, publicacionesInstagram, publicados } from '@/lib/contenido';
import { estaVigente } from '@/lib/reglas';
import { getImage } from 'astro:assets';

// Banners vigentes: cada uno es un slide del hero en carrusel (wireframes: Inicio).
const banners = (await publicados('banners'))
  .filter((b) => estaVigente(b.data, new Date()))
  .sort((a, b) => b.data.inicio.valueOf() - a.data.inicio.valueOf());

// Preload del LCP: la imagen del primer slide se pide en cuanto arranca el documento
// (el <Image priority> de HeroCarrusel ya va con fetchpriority=high; este <link> adelanta
// aún más el request de red). El resto de imágenes va con lazy por defecto (Astro).
const lcp = banners[0]
  ? await getImage({ src: banners[0].data.imagen, widths: [640, 1280, 1920], format: 'webp' }).catch(() => undefined)
  : undefined;

const [noticias, actividades, anuncios, pubInstagram] = await Promise.all([
  noticiasRecientes(3), proximasActividades(), anunciosVigentes(), publicacionesInstagram(3),
]);
---
<Base titulo="BIOING+">
  {lcp && (
    <link
      slot="head"
      rel="preload"
      as="image"
      href={lcp.src}
      imagesrcset={lcp.srcSet?.attribute}
      imagesizes="100vw"
      fetchpriority="high"
    />
  )}
  {banners.length > 0 && <HeroCarrusel banners={banners} />}
  {banners.length === 0 && <h1 class="sr-only">BIOING+</h1>}

  {noticias.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-16">
      <h2 data-animar="fade-up" class="text-3xl font-semibold tracking-tight">Noticias recientes</h2>
      <div data-animar="grilla" class="mt-8 grid gap-6 md:grid-cols-3">{noticias.map((n) => <TarjetaNoticia noticia={n} />)}</div>
    </section>
  )}

  {actividades.length > 0 && (
    <section class="bg-muted">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <h2 data-animar="fade-up" class="text-3xl font-semibold tracking-tight">Próximas actividades</h2>
        <div data-animar="grilla" class="mt-8 grid gap-6 md:grid-cols-3">{actividades.slice(0, 3).map((a) => <TarjetaActividad actividad={a} />)}</div>
      </div>
    </section>
  )}

  {anuncios.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-16">
      <h2 data-animar="fade-up" class="text-3xl font-semibold tracking-tight">Anuncios</h2>
      <div data-animar="grilla" class="mt-8 grid gap-6 md:grid-cols-3">{anuncios.slice(0, 3).map((a) => <TarjetaAnuncio anuncio={a} />)}</div>
    </section>
  )}

  {pubInstagram.length > 0 && (
    <section class="bg-muted">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 data-animar="fade-up" class="text-3xl font-semibold tracking-tight">En Instagram</h2>
          <a href="/instagram" class="inline-flex items-center gap-1 text-sm text-primary hover:underline">Ver más <ArrowRight class="size-4" aria-hidden="true" /></a>
        </div>
        <div data-animar="grilla" class="mt-8 grid gap-6 md:grid-cols-3">{pubInstagram.map((p) => <PublicacionInstagram publicacion={p} />)}</div>
      </div>
    </section>
  )}

  <section class="bg-foreground text-background">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center">
      <h2 data-animar="fade-up" class="text-3xl font-semibold tracking-tight">Directorio de bioingenieros/as</h2>
      <p data-animar="fade-up" class="mx-auto mt-3 max-w-xl opacity-80">Encuentra egresados/as por generación, área y organización.</p>
      <a href="/directorio" class="mt-6 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-2 text-primary-foreground hover:opacity-90">Ir al Directorio <ArrowRight class="size-4" aria-hidden="true" /></a>
    </div>
  </section>
</Base>
