---
import { getEntries, getEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import FiltrosPlegables from '@/components/FiltrosPlegables.astro';
import TarjetaEgresado from '@/components/TarjetaEgresado.astro';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
import { Combobox, ComboboxContent, ComboboxEmpty, ComboboxInput, ComboboxItem } from '@/components/starwind/combobox';
import { egresadosDelDirectorio } from '@/lib/contenido';
import { existentes } from '@/lib/reglas';
import { listaElementos } from '@/lib/schema';
import { TODAS } from '@/lib/filtro-directorio';
import FilePdf from 'phosphor-astro/FilePdf.astro';

const egresados = await Promise.all(
  (await egresadosDelDirectorio()).map(async (persona) => {
    const perfil = persona.data.perfil_egresado!;
    const areas = perfil.areas ? existentes(await getEntries(perfil.areas)) : [];
    const organizacion = perfil.organizacion ? await getEntry(perfil.organizacion) : undefined;
    return { persona, areas, organizacion };
  }),
);

const unicos = <T,>(xs: T[], clave: (x: T) => string) => [...new Map(xs.map((x) => [clave(x), x])).values()];
const generaciones = [...new Set(egresados.map((e) => e.persona.data.perfil_egresado!.generacion).filter((g): g is number => g !== undefined))].sort();
const areas = unicos(egresados.flatMap((e) => e.areas), (a) => a.id).sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'));
const organizaciones = unicos(egresados.flatMap((e) => (e.organizacion ? [e.organizacion] : [])), (o) => o.id).sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'));

// Solo los egresados/as que ya se muestran en el listado (Perfil autorizado y Ficha activa).
const jsonLdPagina = listaElementos(
  'Directorio de bioingenieros/as',
  egresados.map(({ persona }) => ({ name: persona.data.nombre, url: `/personas/${persona.id}` })),
  Astro.site,
);
---
<Base titulo="Directorio" descripcion="Directorio de bioingenieros/as egresados/as de la Universidad de Concepción." jsonLd={jsonLdPagina}>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 data-animar="fade-up" class="text-4xl font-semibold tracking-tight">Directorio de bioingenieros/as</h1>
    <p class="mt-2 text-muted-foreground">Egresados/as que autorizaron publicar su perfil.</p>
    <p class="mt-2">
      <a href="/anuario" class="inline-flex items-center gap-1.5 text-sm text-primary hover:underline">
        <FilePdf class="size-4" aria-hidden="true" />Ver anuario en PDF
      </a>
    </p>

    <form id="filtros" data-filtros-directorio class="mt-8 flex flex-col gap-4 md:flex-row md:flex-wrap md:items-end" role="search">
      <div class="grid gap-2 md:min-w-64 md:flex-1">
        <Label for="texto">Nombre</Label>
        <Input id="texto" name="texto" type="search" placeholder="Buscar por nombre" autocomplete="off" />
      </div>
      <FiltrosPlegables id="filtros-directorio-mas" neutros={[TODAS]}>
        <div class="grid gap-2 [&>*]:min-w-0">
          <Label id="etiqueta-generacion" for="generacion-input">Generación</Label>
          <Combobox id="generacion" name="generacion" defaultValue={TODAS}>
            <ComboboxInput id="generacion-input" placeholder="Todas" showClear />
            <ComboboxContent>
              <ComboboxEmpty>Nadie coincide.</ComboboxEmpty>
              <ComboboxItem value={TODAS}>Todas</ComboboxItem>
              {generaciones.map((g) => <ComboboxItem value={String(g)}>{g}</ComboboxItem>)}
            </ComboboxContent>
          </Combobox>
        </div>
        <div class="grid gap-2 [&>*]:min-w-0">
          <Label id="etiqueta-area" for="area-input">Área</Label>
          <Combobox id="area" name="area" defaultValue={TODAS}>
            <ComboboxInput id="area-input" placeholder="Todas" showClear />
            <ComboboxContent>
              <ComboboxEmpty>Nadie coincide.</ComboboxEmpty>
              <ComboboxItem value={TODAS}>Todas</ComboboxItem>
              {areas.map((a) => <ComboboxItem value={a.id}>{a.data.nombre}</ComboboxItem>)}
            </ComboboxContent>
          </Combobox>
        </div>
        <div class="grid gap-2 [&>*]:min-w-0">
          <Label id="etiqueta-organizacion" for="organizacion-input">Organización</Label>
          <Combobox id="organizacion" name="organizacion" defaultValue={TODAS}>
            <ComboboxInput id="organizacion-input" placeholder="Todas" showClear />
            <ComboboxContent>
              <ComboboxEmpty>Nadie coincide.</ComboboxEmpty>
              <ComboboxItem value={TODAS}>Todas</ComboboxItem>
              {organizaciones.map((o) => <ComboboxItem value={o.id}>{o.data.nombre}</ComboboxItem>)}
            </ComboboxContent>
          </Combobox>
        </div>
      </FiltrosPlegables>
    </form>

    <p id="contador" class="mt-6 text-sm text-muted-foreground" aria-live="polite">{egresados.length} egresados/as</p>
    <h2 class="sr-only">Resultados</h2>
    <ul id="resultados" data-animar="grilla" class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {egresados.map((e) => (
        <TarjetaEgresado persona={e.persona} areas={e.areas.map((a) => a.data.nombre)} organizacion={e.organizacion?.data.nombre} />
      ))}
    </ul>
    <p id="sin-resultados" class="mt-8 hidden text-center text-muted-foreground">No hay egresados/as que coincidan con los filtros.</p>
  </section>
</Base>

<script>
  import { coincide, TODAS, type Filtros } from '@/lib/filtro-directorio';

  // Los <script> de Astro corren una sola vez; con ClientRouter hay que reiniciar en cada
  // astro:page-load (también la primera carga). La marca data-iniciado evita listeners dobles.
  document.addEventListener('astro:page-load', () => {
  const encontrado = document.querySelector<HTMLFormElement>('#filtros[data-filtros-directorio]:not([data-iniciado])');
  if (!encontrado) return;
  const form = encontrado;
  form.dataset.iniciado = '';
  const tarjetas = [...document.querySelectorAll<HTMLLIElement>('#resultados > li')];
  const contador = document.querySelector('#contador')!;
  const sinResultados = document.querySelector('#sin-resultados')!;

  function aplicar() {
    const d = new FormData(form);
    const valor = (k: string) => (d.get(k) as string | null) || TODAS;
    const filtros: Filtros = {
      texto: (d.get('texto') as string | null) ?? '',
      generacion: valor('generacion'),
      area: valor('area'),
      organizacion: valor('organizacion'),
    };
    let visibles = 0;
    for (const li of tarjetas) {
      const ok = coincide({
        nombre: li.dataset.nombre ?? '',
        generacion: li.dataset.generacion ?? '',
        areas: (li.dataset.areas ?? '').split(' ').filter(Boolean),
        organizacion: li.dataset.organizacion ?? '',
      }, filtros);
      li.hidden = !ok;
      if (ok) visibles++;
    }
    contador.textContent = `${visibles} egresados/as`;
    sinResultados.classList.toggle('hidden', visibles > 0);
  }

  form.addEventListener('input', aplicar);
  // Starwind v3 emite starwind:value-change (burbujea) antes de actualizar el valor del
  // input oculto; se difiere la lectura para que FormData vea el valor nuevo.
  form.addEventListener('starwind:value-change', () => setTimeout(aplicar, 0));
  });
</script>
