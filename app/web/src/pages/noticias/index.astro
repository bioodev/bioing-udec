---
import { getEntries } from 'astro:content';
import Base from '@/layouts/Base.astro';
import TarjetaNoticia from '@/components/TarjetaNoticia.astro';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
import { Button } from '@/components/starwind/button';
import { NativeSelect, NativeSelectOption } from '@/components/starwind/native-select';
import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/starwind/select';
import { Combobox, ComboboxContent, ComboboxEmpty, ComboboxInput, ComboboxItem } from '@/components/starwind/combobox';
import CaretLeft from 'phosphor-astro/CaretLeft.astro';
import CaretRight from 'phosphor-astro/CaretRight.astro';
import { noticiasVisibles } from '@/lib/contenido';
import { existentes, normalizar } from '@/lib/reglas';
import { TODAS } from '@/lib/filtro-noticias';

const noticias = await Promise.all(
  (await noticiasVisibles())
    .sort((a, b) => b.data.fecha.valueOf() - a.data.fecha.valueOf())
    .map(async (noticia) => ({
      noticia,
      temas: existentes(await getEntries(noticia.data.temas ?? [])),
      personas: existentes(await getEntries(noticia.data.personas_mencionadas ?? [])),
    })),
);

const porId = <T extends { id: string }>(xs: T[]) => [...new Map(xs.map((x) => [x.id, x])).values()];
const temas = porId(noticias.flatMap((n) => n.temas)).sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'));
const personas = porId(noticias.flatMap((n) => n.personas)).sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'));
const anios = [...new Set(noticias.map((n) => n.noticia.data.fecha.getUTCFullYear()))].sort((a, b) => b - a);
// Etiquetas (tags de texto libre) presentes en las noticias visibles, alfabéticas.
const etiquetas = [...new Set(noticias.flatMap((n) => n.noticia.data.etiquetas ?? []))].sort((a, b) => a.localeCompare(b, 'es'));
---
<Base titulo="Noticias" descripcion="Noticias de la comunidad de Bioingeniería UdeC.">
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="text-4xl font-semibold tracking-tight">Noticias</h1>

    <form id="filtros" class="mt-8 grid gap-4 md:grid-cols-3" role="search" onsubmit="return false">
      <div class="grid gap-2">
        <Label for="texto">Buscar</Label>
        <Input id="texto" name="texto" type="search" placeholder="Título o bajada" autocomplete="off" />
      </div>
      <div class="grid gap-2">
        <Label for="persona-input">Persona mencionada</Label>
        <Combobox id="persona" name="persona">
          <ComboboxInput id="persona-input" placeholder="Buscar persona" showClear />
          <ComboboxContent>
            <ComboboxEmpty>Nadie coincide.</ComboboxEmpty>
            {personas.map((p) => <ComboboxItem value={p.id}>{p.data.nombre}</ComboboxItem>)}
          </ComboboxContent>
        </Combobox>
      </div>
      <div class="grid gap-2">
        <Label id="etiqueta-tema" for="tema-input">Categoría</Label>
        <Combobox id="tema" name="tema" defaultValue={TODAS}>
          <ComboboxInput id="tema-input" placeholder="Todas" showClear />
          <ComboboxContent>
            <ComboboxEmpty>Nadie coincide.</ComboboxEmpty>
            <ComboboxItem value={TODAS}>Todas</ComboboxItem>
            {temas.map((t) => <ComboboxItem value={t.id}>{t.data.nombre}</ComboboxItem>)}
          </ComboboxContent>
        </Combobox>
      </div>
      <div class="grid gap-2">
        <Label for="etiqueta-input">Tag</Label>
        <Combobox id="etiqueta" name="etiqueta">
          <ComboboxInput id="etiqueta-input" placeholder="Filtrar por etiqueta" showClear />
          <ComboboxContent>
            <ComboboxEmpty>Nadie coincide.</ComboboxEmpty>
            {etiquetas.map((e) => <ComboboxItem value={e}>#{e}</ComboboxItem>)}
          </ComboboxContent>
        </Combobox>
      </div>
      <div class="grid gap-2 [&>[data-slot=native-select-wrapper]]:w-full">
        <Label for="anio">Año</Label>
        <NativeSelect id="anio" name="anio">
          <NativeSelectOption value={TODAS}>Todos</NativeSelectOption>
          {anios.map((a) => <NativeSelectOption value={String(a)}>{a}</NativeSelectOption>)}
        </NativeSelect>
      </div>
      <div class="grid gap-2">
        <Label id="etiqueta-orden" for="orden">Ordenar por</Label>
        <Select id="orden" name="orden" defaultValue="recientes">
          <SelectTrigger class="w-full" aria-labelledby="etiqueta-orden"><SelectValue placeholder="Recientes" /></SelectTrigger>
          <SelectContent>
            <SelectItem value="recientes">Recientes</SelectItem>
            <SelectItem value="antiguas">Antiguas</SelectItem>
            <SelectItem value="alfabetico">A-Z</SelectItem>
            <SelectItem value="relevancia">Relevancia</SelectItem>
          </SelectContent>
        </Select>
      </div>
      <input type="hidden" id="opciones-etiqueta" value={JSON.stringify(etiquetas)} />
      <input type="hidden" id="opciones-tema" value={JSON.stringify(temas.map((t) => t.id))} />
    </form>

    <p id="contador" class="mt-6 text-sm text-muted-foreground" aria-live="polite">{noticias.length} noticias</p>
    <h2 class="sr-only">Resultados</h2>
    <ul id="lista" class="mt-4 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {noticias.map(({ noticia, temas, personas }) => (
        <li
          data-texto={normalizar(`${noticia.data.titulo} ${noticia.data.bajada ?? ''}`)}
          data-temas={temas.map((t) => t.id).join(' ')}
          data-etiquetas={JSON.stringify(noticia.data.etiquetas ?? [])}
          data-personas={personas.map((p) => p.id).join(' ')}
          data-anio={String(noticia.data.fecha.getUTCFullYear())}
          data-fecha={String(noticia.data.fecha.valueOf())}
          data-titulo={noticia.data.titulo}
        >
          <TarjetaNoticia noticia={noticia} />
        </li>
      ))}
    </ul>
    <p id="sin-resultados" class="mt-8 hidden text-center text-muted-foreground">No hay noticias que coincidan con los filtros.</p>

    <nav id="paginacion" aria-label="Paginación" class="mt-10 flex items-center justify-center gap-4">
      <Button id="anterior" variant="outline" class="rounded-full"><CaretLeft class="size-4" aria-hidden="true" />Anterior</Button>
      <span id="pagina" class="text-sm text-muted-foreground"></span>
      <Button id="siguiente" variant="outline" class="rounded-full">Siguiente<CaretRight class="size-4" aria-hidden="true" /></Button>
    </nav>
  </section>
</Base>

<script>
  import { coincideNoticia, ordenarNoticias, paginar, TODAS, type FiltrosNoticias, type OrdenNoticias } from '@/lib/filtro-noticias';

  const POR_PAGINA = 12;
  const ORDENES = ['recientes', 'antiguas', 'alfabetico', 'relevancia'];
  const form = document.querySelector<HTMLFormElement>('#filtros')!;
  const anio = document.querySelector<HTMLSelectElement>('#anio')!;
  const items = [...document.querySelectorAll<HTMLLIElement>('#lista > li')];
  const lista = document.querySelector<HTMLUListElement>('#lista')!;
  const contador = document.querySelector('#contador')!;
  const sinResultados = document.querySelector('#sin-resultados')!;
  const paginacion = document.querySelector<HTMLElement>('#paginacion')!;
  const anterior = document.querySelector<HTMLButtonElement>('#anterior')!;
  const siguiente = document.querySelector<HTMLButtonElement>('#siguiente')!;
  const textoPagina = document.querySelector('#pagina')!;
  const etiquetasValidas = JSON.parse(document.querySelector<HTMLInputElement>('#opciones-etiqueta')!.value) as string[];
  const temasValidos = JSON.parse(document.querySelector<HTMLInputElement>('#opciones-tema')!.value) as string[];
  let pagina = 1;

  function filtros(): FiltrosNoticias {
    const d = new FormData(form);
    return {
      texto: (d.get('texto') as string | null) ?? '',
      tema: (d.get('tema') as string | null) || TODAS,
      etiqueta: (d.get('etiqueta') as string | null) || TODAS,
      persona: (d.get('persona') as string | null) ?? '',
      anio: (d.get('anio') as string | null) || TODAS,
    };
  }

  const datosDe = (li: HTMLLIElement) => ({
    texto: li.dataset.texto ?? '',
    temas: (li.dataset.temas ?? '').split(' ').filter(Boolean),
    etiquetas: JSON.parse(li.dataset.etiquetas ?? '[]') as string[],
    personas: (li.dataset.personas ?? '').split(' ').filter(Boolean),
    anio: li.dataset.anio ?? '',
  });

  function aplicar(desdePrimera = true) {
    if (desdePrimera) pagina = 1;
    const f = filtros();
    const orden = ((new FormData(form)).get('orden') as string | null) || 'recientes';
    const visibles = items.filter((li) => coincideNoticia(datosDe(li), f));
    // Se reordenan en el DOM para que la paginación siga el orden elegido.
    const ordenados = ordenarNoticias(
      visibles.map((li) => ({ li, fecha: new Date(Number(li.dataset.fecha ?? 0)), titulo: li.dataset.titulo ?? '' })),
      orden as OrdenNoticias,
      f.texto !== '',
    );
    for (const o of ordenados) lista.appendChild(o.li);
    const p = paginar(ordenados.map((o) => o.li), pagina, POR_PAGINA);
    pagina = p.pagina;
    const mostrar = new Set(p.items);
    for (const li of items) li.hidden = !mostrar.has(li);

    contador.textContent = visibles.length === 1 ? '1 noticia' : `${visibles.length} noticias`;
    sinResultados.classList.toggle('hidden', visibles.length > 0);
    paginacion.hidden = p.totalPaginas <= 1;
    textoPagina.textContent = `Página ${p.pagina} de ${p.totalPaginas}`;
    anterior.disabled = p.pagina === 1;
    siguiente.disabled = p.pagina === p.totalPaginas;

    // Los filtros quedan en la URL para compartir el listado filtrado.
    const url = new URL(location.href);
    for (const [k, v] of Object.entries({ q: f.texto, tema: f.tema, etiqueta: f.etiqueta, persona: f.persona, anio: f.anio, orden: orden === 'recientes' ? '' : orden, pagina: String(p.pagina) })) {
      if (v && v !== TODAS && !(k === 'pagina' && v === '1')) url.searchParams.set(k, v); else url.searchParams.delete(k);
    }
    history.replaceState(null, '', url);
  }

  // Estado inicial desde la URL (p. ej. /noticias?tema=logros desde el detalle de una Noticia).
  const params = new URLSearchParams(location.search);
  (document.querySelector<HTMLInputElement>('#texto')!).value = params.get('q') ?? '';
  if (params.get('anio') && [...anio.options].some((o) => o.value === params.get('anio'))) anio.value = params.get('anio')!;
  if (params.get('persona')) {
    document.querySelector('#persona')?.dispatchEvent(new CustomEvent('starwind:set-value', { detail: { value: params.get('persona') } }));
  }
  if (params.get('tema') && temasValidos.includes(params.get('tema')!)) {
    document.querySelector('#tema')?.dispatchEvent(new CustomEvent('starwind:set-value', { detail: { value: params.get('tema') } }));
  }
  if (params.get('etiqueta') && etiquetasValidas.includes(params.get('etiqueta')!)) {
    document.querySelector('#etiqueta')?.dispatchEvent(new CustomEvent('starwind:set-value', { detail: { value: params.get('etiqueta') } }));
  }
  if (params.get('orden') && ORDENES.includes(params.get('orden')!)) {
    document.querySelector('#orden')?.dispatchEvent(new CustomEvent('starwind:set-value', { detail: { value: params.get('orden') } }));
  }
  pagina = Number(params.get('pagina')) || 1;

  form.addEventListener('input', () => aplicar());
  form.addEventListener('change', () => aplicar());
  // Starwind v3: el Combobox/Select emite starwind:value-change antes de fijar el valor.
  form.addEventListener('starwind:value-change', () => setTimeout(aplicar, 0));
  anterior.addEventListener('click', () => { pagina--; aplicar(false); scrollTo({ top: 0 }); });
  siguiente.addEventListener('click', () => { pagina++; aplicar(false); scrollTo({ top: 0 }); });
  // El Combobox termina de inicializarse después; se aplica cuando el navegador queda libre.
  setTimeout(() => aplicar(false), 0);
</script>
