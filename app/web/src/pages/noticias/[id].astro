---
import { getEntries, getEntry, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import EnlaceFicha from '@/components/EnlaceFicha.astro';
import PublicacionInstagram from '@/components/PublicacionInstagram.astro';
import Migas from '@/components/Migas.astro';
import TarjetaNoticia from '@/components/TarjetaNoticia.astro';
import { formatoFecha, formatoFechaHora, noticiasVisibles, relacionadasDe } from '@/lib/contenido';
import { existentes } from '@/lib/reglas';
import { minutosLectura } from '@/lib/lectura';
import { idYouTube } from '@/lib/enlaces';
import VideoModal from '@/components/VideoModal.astro';
import GaleriaImagenes from '@/components/GaleriaImagenes.astro';
import Incrustados from '@/components/Incrustados.astro';
import Enlaces from '@/components/Enlaces.astro';
import { migas, noticia as jsonLdNoticia } from '@/lib/schema';
import CalendarBlank from 'phosphor-astro/CalendarBlank.astro';
import ArrowRight from 'phosphor-astro/ArrowRight.astro';
import { Badge } from '@/components/starwind/badge';

export async function getStaticPaths() {
  const noticias = await noticiasVisibles();
  return noticias.map((noticia) => ({ params: { id: noticia.id }, props: { noticia } }));
}

interface Props { noticia: CollectionEntry<'noticias'> }
const { noticia } = Astro.props;
const { Content } = await render(noticia);
// existentes(): una referencia a una entrada borrada se descarta en vez de romper el build.
const personas = existentes(await getEntries(noticia.data.personas_mencionadas ?? []));
const organizaciones = existentes(await getEntries(noticia.data.organizaciones_mencionadas ?? []));
const temas = existentes(await getEntries(noticia.data.temas ?? []));
const actividad = noticia.data.actividad ? await getEntry(noticia.data.actividad) : undefined;
const cobertura = actividad?.data.publicado ? actividad : undefined;
const ig = noticia.data.instagram && (await getEntry(noticia.data.instagram));
const areas = existentes(await getEntries(noticia.data.areas ?? []));
const etiquetas = noticia.data.etiquetas ?? [];
const lectura = minutosLectura(noticia.body ?? '');
// Sin video reconocido (idYouTube devuelve null) no se muestra nada.
const video = noticia.data.video ? idYouTube(noticia.data.video) : null;
const galeria = noticia.data.galeria ?? [];
const relacionadas = await relacionadasDe(noticia);

const enlace = `/noticias/${noticia.id}`;
// Las mismas migas se muestran arriba de la página y van al JSON-LD (BreadcrumbList).
const rutas = [
  { name: 'Inicio', url: '/' },
  { name: 'Noticias', url: '/noticias' },
  { name: noticia.data.titulo, url: enlace },
];
const jsonLdPagina = [
  migas(rutas, Astro.site),
  jsonLdNoticia(noticia, {
    site: Astro.site,
    url: enlace,
    temas: temas.map((t) => t.data.nombre),
    areas: areas.map((a) => a.data.nombre),
    personas: personas.map((p) => (p.data.ficha_activa ? { nombre: p.data.nombre, url: `/personas/${p.id}` } : { nombre: p.data.nombre })),
    organizaciones: organizaciones.map((o) => ({ nombre: o.data.nombre })),
  }),
];
---
<Base titulo={noticia.data.titulo} descripcion={noticia.data.bajada} imagen={noticia.data.imagen?.src} jsonLd={jsonLdPagina}>
  <article class="mx-auto w-full max-w-3xl px-4 py-12 lg:grid lg:max-w-6xl lg:grid-cols-[minmax(0,48rem)_16rem] lg:justify-center lg:gap-x-12">
    <header class="lg:col-start-1 lg:row-start-1">
      <Migas items={rutas} />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight">{noticia.data.titulo}</h1>
      {noticia.data.bajada && <p class="mt-4 text-xl text-muted-foreground">{noticia.data.bajada}</p>}
      <Enlaces items={noticia.data.enlaces ?? []} />
      {noticia.data.imagen && <Image src={noticia.data.imagen} alt={noticia.data.imagen_alt ?? ''} class="mt-8 aspect-video w-full rounded-lg object-cover" widths={[768, 1536]} sizes="(min-width: 768px) 768px, 100vw" />}
    </header>

    {/* En móvil va antes del cuerpo; en escritorio, columna lateral fija junto al texto. */}
    <aside aria-label="Información de la noticia" class="mt-8 rounded-lg bg-muted p-5 text-sm lg:sticky lg:top-24 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:self-start">
      <dl class="grid gap-4">
        <div>
          <dt class="text-muted-foreground">Fecha</dt>
          <dd class="mt-1 font-medium"><time datetime={noticia.data.fecha.toISOString().slice(0, 10)}>{formatoFecha(noticia.data.fecha)}</time></dd>
        </div>
        {temas.length > 0 && (
          <div>
            <dt class="text-muted-foreground">Categoría</dt>
            <dd class="mt-1 flex flex-wrap gap-2">
              {temas.map((t) => <Badge variant="outline" href={`/noticias?tema=${t.id}`}>{t.data.nombre}</Badge>)}
            </dd>
          </div>
        )}
        {etiquetas.length > 0 && (
          <div>
            <dt class="text-muted-foreground">Etiquetas</dt>
            <dd class="mt-1 flex flex-wrap gap-2">
              {etiquetas.map((e) => <Badge variant="secondary" href={`/noticias?etiqueta=${encodeURIComponent(e)}`}>#{e}</Badge>)}
            </dd>
          </div>
        )}
        {areas.length > 0 && (
          <div>
            <dt class="text-muted-foreground">Áreas</dt>
            <dd class="mt-1 font-medium">{areas.map((a) => a.data.nombre).join(', ')}</dd>
          </div>
        )}
        <div>
          <dt class="text-muted-foreground">Lectura</dt>
          <dd class="mt-1 font-medium">{lectura} min</dd>
        </div>
      </dl>
    </aside>

    <div class="lg:col-start-1 lg:row-start-2">
      <div class="prose mt-8 max-w-none"><Content /></div>

    {video && (
      <div class="mt-10">
        <VideoModal id={video} titulo={noticia.data.titulo} />
      </div>
    )}

    <Incrustados items={noticia.data.incrustados ?? []} />

    {galeria.length > 0 && (
      <section id="noticia-galeria" class="mt-10" aria-labelledby="galeria-titulo">
        <h2 id="galeria-titulo" class="text-xl font-semibold tracking-tight">Galería</h2>
        <div class="mt-4"><GaleriaImagenes items={galeria} /></div>
      </section>
    )}

    {ig?.data.publicado && (
      <section id="noticia-instagram" class="mt-10">
        <h2 class="text-xl font-semibold tracking-tight">En Instagram</h2>
        <div class="mt-4 max-w-md"><PublicacionInstagram publicacion={ig} /></div>
      </section>
    )}

    {cobertura && (
      <aside class="mt-10 rounded-lg bg-muted p-5">
        <p class="flex items-center gap-1.5 text-sm text-muted-foreground"><CalendarBlank class="size-4" aria-hidden="true" />Cobertura de la actividad</p>
        <p class="font-semibold"><a href={`/agenda/${cobertura.id}`} class="hover:text-primary">{cobertura.data.titulo}</a> · {formatoFechaHora(cobertura.data.inicio)}</p>
      </aside>
    )}

    {(personas.length > 0 || organizaciones.length > 0) && (
      <section id="noticia-datos" class="mt-10 border-t border-border pt-6 text-sm">
        {personas.length > 0 && (
          <p><span class="text-muted-foreground">Personas: </span>
            {personas.map((p, i) => <>{i > 0 && ', '}<EnlaceFicha coleccion="personas" entrada={p} /></>)}
          </p>
        )}
        {organizaciones.length > 0 && (
          <p class="mt-2"><span class="text-muted-foreground">Organizaciones: </span>
            {organizaciones.map((o, i) => <>{i > 0 && ', '}<EnlaceFicha coleccion="organizaciones" entrada={o} /></>)}
          </p>
        )}
      </section>
    )}
    </div>
  </article>

  {relacionadas.length > 0 && (
    <section id="noticia-relacionadas" class="mx-auto max-w-6xl px-4 pb-16" aria-labelledby="te-puede-interesar">
      <div class="flex flex-wrap items-end justify-between gap-4 border-t border-border pt-10">
        <h2 id="te-puede-interesar" class="text-3xl font-semibold tracking-tight">Te puede interesar</h2>
        <a href="/noticias" class="inline-flex items-center gap-1 text-sm text-primary hover:underline">Ver todas las noticias <ArrowRight class="size-4" aria-hidden="true" /></a>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">{relacionadas.map((n) => <TarjetaNoticia noticia={n} />)}</div>
    </section>
  )}
</Base>
