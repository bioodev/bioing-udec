---
import { resolverSeo } from '@/lib/seo';
import { getEntries, getEntry, render, type CollectionEntry } from 'astro:content';
import Base from '@/layouts/Base.astro';
import EnlaceFicha from '@/components/EnlaceFicha.astro';
import Distintivo from '@/components/Distintivo.astro';
import Compartir from '@/components/Compartir.astro';
import TiempoRelativo from '@/components/TiempoRelativo.astro';
import { Button } from '@/components/starwind/button';
import { anunciosVisibles, formatoFecha, seoDeEntrada } from '@/lib/contenido';
import { anuncioVigente, existentes } from '@/lib/reglas';
import { migas, ofertaLaboral } from '@/lib/schema';
import { TIPOS_ANUNCIO } from '@/lib/anuncios';
import ArrowLeft from 'phosphor-astro/ArrowLeft.astro';
import ArrowSquareOut from 'phosphor-astro/ArrowSquareOut.astro';

export async function getStaticPaths() {
  const anuncios = await anunciosVisibles();
  return anuncios.map((anuncio) => ({ params: { id: anuncio.id }, props: { anuncio } }));
}

interface Props { anuncio: CollectionEntry<'anuncios'> }
const { anuncio } = Astro.props;
const { Content } = await render(anuncio);

const vigente = anuncioVigente(anuncio.data, new Date());
const areas = existentes(await getEntries(anuncio.data.areas ?? []));

// EnlaceFicha necesita saber la colección del Oferente (Persona u Organización).
const o = anuncio.data.oferente;
const entrada = await (o.tipo === 'persona' ? getEntry(o.persona) : getEntry(o.organizacion));
const oferente = entrada && { coleccion: o.tipo === 'persona' ? ('personas' as const) : ('organizaciones' as const), entrada };

const esCorreo = /^\S+@\S+$/.test(anuncio.data.contacto);

const enlaceAnuncio = `/anuncios/${anuncio.id}`;
// JobPosting solo para ofertas laborales vigentes; ofertaLaboral() devuelve null en el resto.
const oferta = ofertaLaboral(anuncio, {
  site: Astro.site,
  url: enlaceAnuncio,
  oferente: oferente ? { tipo: o.tipo, nombre: oferente.entrada.data.nombre } : undefined,
  areas: areas.map((a) => a.data.nombre),
});
const jsonLdPagina = [
  migas(
    [
      { name: 'Inicio', url: '/' },
      { name: 'Anuncios', url: '/anuncios' },
      { name: anuncio.data.titulo, url: enlaceAnuncio },
    ],
    Astro.site,
  ),
  ...(oferta ? [oferta] : []),
];
const seo = resolverSeo({ titulo: anuncio.data.titulo, descripcion: `${TIPOS_ANUNCIO[anuncio.data.tipo]} · ${anuncio.data.titulo}` }, seoDeEntrada(anuncio.data.seo));
---
<Base titulo={seo.titulo} descripcion={seo.descripcion} imagen={seo.imagen} noindex={seo.noindex} jsonLd={jsonLdPagina}>
  <article class="mx-auto w-full max-w-3xl px-4 py-12 lg:grid lg:max-w-6xl lg:grid-cols-[minmax(0,48rem)_18rem] lg:justify-center lg:gap-x-12">
    <header class="lg:col-start-1 lg:row-start-1">
      <div class="flex flex-wrap items-center gap-2">
        <Distintivo clase="tipo">{TIPOS_ANUNCIO[anuncio.data.tipo]}</Distintivo>
        {!vigente && <Distintivo clase="vencido">Vencido</Distintivo>}
      </div>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight">{anuncio.data.titulo}</h1>
    </header>

    {/* En móvil va entre el título y el cuerpo; en escritorio, columna lateral fija junto al texto. */}
    <aside aria-label="Información del anuncio" class="mt-8 rounded-lg bg-muted p-5 text-sm lg:sticky lg:top-24 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:mt-0 lg:self-start">
      <h2 class="sr-only">Datos del anuncio</h2>
      <dl class="grid gap-4">
        <div>
          <dt class="text-muted-foreground">Publicado el</dt>
          <dd class="mt-1 font-medium"><time datetime={anuncio.data.fecha.toISOString().slice(0, 10)}>{formatoFecha(anuncio.data.fecha)}</time><TiempoRelativo fecha={anuncio.data.fecha} /></dd>
        </div>
        {anuncio.data.fecha_limite && (
          <div>
            <dt class="text-muted-foreground">Postula hasta el</dt>
            <dd class="mt-1 font-medium"><time datetime={anuncio.data.fecha_limite.toISOString().slice(0, 10)}>{formatoFecha(anuncio.data.fecha_limite)}</time><TiempoRelativo fecha={anuncio.data.fecha_limite} /></dd>
          </div>
        )}
        {oferente && (
          <div>
            <dt class="text-muted-foreground">Oferente</dt>
            <dd class="mt-1 font-medium"><EnlaceFicha coleccion={oferente.coleccion} entrada={oferente.entrada} /></dd>
          </div>
        )}
        {areas.length > 0 && (
          <div>
            <dt class="text-muted-foreground">Áreas</dt>
            <dd class="mt-1 font-medium">{areas.map((a) => a.data.nombre).join(' · ')}</dd>
          </div>
        )}
        <div>
          <dt class="text-muted-foreground">Contacto</dt>
          <dd class="mt-1 font-medium break-words">{esCorreo ? <a href={`mailto:${anuncio.data.contacto}`} class="text-primary hover:underline">{anuncio.data.contacto}</a> : anuncio.data.contacto}</dd>
        </div>
      </dl>

      {anuncio.data.enlace && vigente && (
        <p class="mt-6">
          <Button as="a" href={anuncio.data.enlace} target="_blank" rel="noopener" class="w-full rounded-full">
            Más información<ArrowSquareOut class="size-4" aria-hidden="true" />
          </Button>
        </p>
      )}

      <div class="mt-6 border-t border-border pt-6">
        <Compartir url={enlaceAnuncio} titulo={anuncio.data.titulo} />
      </div>
    </aside>

    <div class="lg:col-start-1 lg:row-start-2">
      <div class="prose mt-8 max-w-none"><Content /></div>

      <p class="mt-10 border-t border-border pt-6 text-sm"><a href="/anuncios" class="inline-flex items-center gap-1 text-primary hover:underline"><ArrowLeft class="size-4" aria-hidden="true" /> Volver a Anuncios</a></p>
    </div>
  </article>
</Base>
