---
import VideoModal from '@/components/VideoModal.astro';
import ArrowSquareOut from 'phosphor-astro/ArrowSquareOut.astro';
import { incrustado } from '@/lib/incrustados';

interface Props { items: { url: string; titulo?: string }[] }
const { items } = Astro.props;
// Twitch exige el dominio donde se muestra (parent): el de Astro.site y localhost para la vista de desarrollo.
const dominios = [Astro.site?.hostname, 'localhost'].filter((d): d is string => Boolean(d));
const piezas = items.map((item) => ({ ...item, incrustado: incrustado(item.url, { dominios }) }));

// Alto fijo de cada proveedor. Clases completas y literales: Tailwind las detecta en el código fuente.
const ALTO: Record<number, string> = {
  152: 'h-[152px]',
  166: 'h-[166px]',
  175: 'h-[175px]',
  190: 'h-[190px]',
  200: 'h-[200px]',
  252: 'h-[252px]',
  352: 'h-[352px]',
  400: 'h-[400px]',
  450: 'h-[450px]',
  480: 'h-[480px]',
  500: 'h-[500px]',
  600: 'h-[600px]',
  740: 'h-[740px]',
};

// Permisos mínimos por proveedor; el resto no pide ninguno.
const PERMISOS: Record<string, string> = {
  Spotify: 'encrypted-media; clipboard-write',
  Vimeo: 'fullscreen; picture-in-picture',
  Facebook: 'fullscreen',
  YouTube: 'encrypted-media; picture-in-picture',
  Twitch: 'autoplay; fullscreen',
  Loom: 'autoplay; fullscreen',
  Dailymotion: 'autoplay; fullscreen',
};
---
{piezas.length > 0 && (
  <section id="incrustados" class="mt-10" aria-labelledby="incrustados-titulo">
    <h2 id="incrustados-titulo" class="text-xl font-semibold tracking-tight">Multimedia</h2>
    <ul role="list" class="mt-4 grid gap-6">
      {piezas.map(({ titulo, incrustado: inc }) => (
        <li>
          {inc.tipo === 'youtube' && <VideoModal id={inc.id} titulo={titulo ?? 'Video de YouTube'} />}

          {inc.tipo === 'iframe' && (
            <div class:list={['relative', inc.vertical && 'mx-auto max-w-sm']} data-incrustado>
              {/* Esqueleto oculto por defecto: el script lo muestra mientras el iframe carga. Sin JS no aparece. */}
              <div data-esqueleto aria-hidden="true" class="absolute inset-0 hidden place-items-center rounded-lg bg-muted text-sm text-muted-foreground motion-safe:animate-pulse">
                {inc.proveedor}
              </div>
              <iframe
                src={inc.src}
                title={titulo ?? `${inc.proveedor}: contenido incrustado`}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allow={PERMISOS[inc.proveedor]}
                allowfullscreen={inc.proporcion !== undefined && !PERMISOS[inc.proveedor]?.includes('fullscreen')}
                class:list={['relative w-full rounded-lg border-0', inc.proporcion ? 'aspect-video' : (ALTO[inc.alto ?? 0] ?? 'aspect-video')]}
              />
            </div>
          )}

          {inc.tipo === 'enlace' && (
            <a
              href={inc.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between gap-4 rounded-lg border border-border bg-card p-5 hover:border-primary"
            >
              <span class="min-w-0">
                {inc.proveedor && <span class="block text-sm text-muted-foreground">{inc.proveedor}</span>}
                <span class="block break-words font-medium">{titulo ?? inc.url}</span>
              </span>
              <ArrowSquareOut class="size-5 shrink-0" aria-hidden="true" />
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>
)}

<script>
  // Esqueleto mientras carga cada iframe: se muestra y se quita con el evento load. El init corre al
  // ejecutarse el módulo (la carga inicial, antes de que los iframes de la vista terminen) y en cada
  // astro:page-load (navegaciones con ClientRouter). La marca data-iniciado evita duplicados.
  // Si el iframe ya terminó de cargar antes de iniciar, su entrada en Resource Timing evita un esqueleto que no se iría.
  function iniciar() {
    const cargados = new Set(performance.getEntriesByType('resource').map((e) => e.name));
    for (const bloque of document.querySelectorAll<HTMLElement>('[data-incrustado]:not([data-iniciado])')) {
      bloque.dataset.iniciado = '';
      const iframe = bloque.querySelector('iframe')!;
      if (cargados.has(iframe.src)) continue;
      const esqueleto = bloque.querySelector<HTMLElement>('[data-esqueleto]')!;
      esqueleto.classList.replace('hidden', 'grid');
      iframe.classList.add('opacity-0', 'transition-opacity', 'duration-300', 'motion-reduce:transition-none');
      const mostrar = () => {
        esqueleto.remove();
        iframe.classList.remove('opacity-0');
      };
      iframe.addEventListener('load', mostrar, { once: true });
      // Red de seguridad: si el load ya pasó sin quedar registrado, el iframe no debe quedar invisible.
      window.setTimeout(mostrar, 8000);
    }
  }
  iniciar();
  document.addEventListener('astro:page-load', iniciar);
</script>
