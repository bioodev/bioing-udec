---
import VideoModal from '@/components/VideoModal.astro';
import ArrowSquareOut from 'phosphor-astro/ArrowSquareOut.astro';
import { incrustado } from '@/lib/incrustados';

interface Props { items: { url: string; titulo?: string }[] }
const { items } = Astro.props;
// Twitch exige el dominio donde se muestra (parent): el de Astro.site y localhost para la vista de desarrollo.
const dominios = [Astro.site?.hostname, 'localhost'].filter((d): d is string => Boolean(d));
const piezas = items.map((item) => ({ ...item, incrustado: incrustado(item.url, { dominios }) }));

// Alto fijo de cada proveedor. Clases completas y literales: Tailwind las detecta en el código fuente.
const ALTO: Record<number, string> = {
  152: 'h-[152px]',
  166: 'h-[166px]',
  175: 'h-[175px]',
  190: 'h-[190px]',
  200: 'h-[200px]',
  252: 'h-[252px]',
  352: 'h-[352px]',
  400: 'h-[400px]',
  450: 'h-[450px]',
  480: 'h-[480px]',
  500: 'h-[500px]',
  600: 'h-[600px]',
  740: 'h-[740px]',
};

// Permisos mínimos por proveedor; el resto no pide ninguno.
const PERMISOS: Record<string, string> = {
  Spotify: 'encrypted-media; clipboard-write',
  Vimeo: 'fullscreen; picture-in-picture',
  Facebook: 'fullscreen',
  YouTube: 'encrypted-media; picture-in-picture',
  Twitch: 'autoplay; fullscreen',
  Loom: 'autoplay; fullscreen',
  Dailymotion: 'autoplay; fullscreen',
};
---
{piezas.length > 0 && (
  <section class="mt-10" aria-labelledby="incrustados-titulo">
    <h2 id="incrustados-titulo" class="text-xl font-semibold tracking-tight">Multimedia</h2>
    <ul class="mt-4 grid gap-6">
      {piezas.map(({ titulo, incrustado: inc }) => (
        <li>
          {inc.tipo === 'youtube' && <VideoModal id={inc.id} titulo={titulo ?? 'Video de YouTube'} />}

          {inc.tipo === 'iframe' && (
            <iframe
              src={inc.src}
              title={titulo ?? `${inc.proveedor}: contenido incrustado`}
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              allow={PERMISOS[inc.proveedor]}
              allowfullscreen={inc.proporcion !== undefined}
              class:list={['w-full rounded-lg border-0', inc.proporcion ? 'aspect-video' : (ALTO[inc.alto ?? 0] ?? 'aspect-video'), inc.vertical && 'mx-auto max-w-sm']}
            />
          )}

          {inc.tipo === 'enlace' && (
            <a
              href={inc.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-between gap-4 rounded-lg border border-border bg-card p-5 hover:border-primary"
            >
              <span class="min-w-0">
                {inc.proveedor && <span class="block text-sm text-muted-foreground">{inc.proveedor}</span>}
                <span class="block break-words font-medium">{titulo ?? inc.url}</span>
              </span>
              <ArrowSquareOut class="size-5 shrink-0" aria-hidden="true" />
            </a>
          )}
        </li>
      ))}
    </ul>
  </section>
)}
