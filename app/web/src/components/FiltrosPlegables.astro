---
// Agrupa los filtros de un listado en un pliegue: en móvil es un acordeón a ancho completo; en escritorio los
// botones quedan a la derecha del buscador (ancho natural, alineados abajo) y la región ocupa su propia fila con
// una grilla de `columnas` columnas. Requiere que el `<form>` de la página sea flex (`md:flex-row md:flex-wrap`).
// Parte plegado si no hay filtros activos y desplegado si llegan por la URL (la decisión la toma el script). El
// texto de búsqueda queda fuera del pliegue, en la página. Sin JavaScript el botón está oculto y los filtros
// quedan visibles.
// Lógica en src/scripts/filtros-plegables.ts.
import CaretDown from 'phosphor-astro/CaretDown.astro';
import FunnelSimple from 'phosphor-astro/FunnelSimple.astro';

interface Props {
  id: string;
  /** Valores que significan "sin filtrar" (además del vacío), para contar los filtros activos. */
  neutros?: string[];
  /** Columnas de la región en escritorio (≥ md). Con 1 la región es una columna. */
  columnas?: 1 | 2 | 3 | 4;
}
const { id, neutros = [], columnas = 3 } = Astro.props;

// Clases completas (no construidas) para que Tailwind las genere.
const grilla = { 1: '', 2: 'md:grid-cols-2', 3: 'md:grid-cols-3', 4: 'md:grid-cols-4' }[columnas];
---
<button
  type="button"
  data-plegable-boton
  aria-controls={id}
  aria-expanded="false"
  hidden
  class="flex h-11 w-full items-center justify-between self-end rounded-lg border border-input px-4 text-sm font-medium md:w-auto md:shrink-0 md:justify-start md:gap-2"
>
  <span class="flex items-center gap-2">
    <FunnelSimple class="size-4" aria-hidden="true" />
    <span data-plegable-texto>Filtros</span>
  </span>
  <CaretDown class="size-4 transition-transform [[aria-expanded=true]>&]:rotate-180" aria-hidden="true" />
</button>
<button
  type="button"
  data-plegable-limpiar={id}
  hidden
  class="h-11 w-full self-end rounded-lg px-4 text-sm font-medium text-primary underline-offset-4 hover:underline md:w-auto md:shrink-0"
>
  Limpiar filtros
</button>
<div id={id} data-plegable data-neutros={neutros.join(',')} class={`grid w-full gap-4 md:basis-full data-[plegado]:hidden ${grilla}`}>
  <slot />
</div>
