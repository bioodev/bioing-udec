---
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import EnlaceFicha from '@/components/EnlaceFicha.astro';
import { formatoFecha } from '@/lib/contenido';
import { MODALIDADES, TIPOS_ACTIVIDAD } from '@/lib/agenda';
import CalendarBlank from 'phosphor-astro/CalendarBlank.astro';
import Clock from 'phosphor-astro/Clock.astro';
import MapPin from 'phosphor-astro/MapPin.astro';
import Users from 'phosphor-astro/Users.astro';
import ArrowUpRight from 'phosphor-astro/ArrowUpRight.astro';

interface Props { actividad: CollectionEntry<'actividades'> }
const { actividad } = Astro.props;

const ZONA = 'America/Santiago';
const hora = (d: Date) => d.toLocaleTimeString('es-CL', { timeZone: ZONA, hour: '2-digit', minute: '2-digit' });

// EnlaceFicha necesita saber la colección de cada organizador (Persona u Organización).
const organizadores = (
  await Promise.all(
    actividad.data.organizadores.map(async (o) => {
      const entrada = await (o.tipo === 'persona' ? getEntry(o.persona) : getEntry(o.organizacion));
      return entrada && { coleccion: o.tipo === 'persona' ? ('personas' as const) : ('organizaciones' as const), entrada };
    }),
  )
).filter((o): o is NonNullable<typeof o> => Boolean(o));

/** Primer párrafo del cuerpo markdown, sin la sintaxis, para la descripción corta de la tarjeta. */
function descripcionCorta(body: string, max = 180): string {
  const texto = body
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '') // imágenes
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1') // enlaces → su texto
    .replace(/^#{1,6}\s+/gm, '') // encabezados
    .replace(/^\s*>\s?/gm, '') // citas
    .replace(/[*_~`]/g, '') // énfasis y código
    .replace(/\s+/g, ' ')
    .trim();
  return texto.length > max ? `${texto.slice(0, max).trimEnd()}…` : texto;
}

const descripcion = descripcionCorta(actividad.body ?? '');
const enlace = actividad.data.enlace_inscripcion ?? `/agenda/${actividad.id}`;
const externo = String(enlace).startsWith('http://') || String(enlace).startsWith('https://');
const lugar = actividad.data.lugar ?? MODALIDADES[actividad.data.modalidad];
---
<article class="group relative flex h-full flex-col overflow-hidden rounded-lg border border-border bg-card">
  {actividad.data.imagen
    ? <Image src={actividad.data.imagen} alt="" class="aspect-video w-full object-cover" widths={[400, 800]} sizes="(min-width: 768px) 33vw, 100vw" />
    : <div class="aspect-video w-full bg-muted" aria-hidden="true"></div>}
  <div class="flex flex-1 flex-col gap-2 p-5">
    <div class="flex flex-wrap items-center gap-2">
      <Badge variant="default">{TIPOS_ACTIVIDAD[actividad.data.tipo]}</Badge>
      <span class="text-xs text-muted-foreground">{MODALIDADES[actividad.data.modalidad]}</span>
    </div>
    <h3 class="text-lg font-semibold leading-snug">
      {/* Enlace principal que extiende su área a toda la tarjeta (imagen incluida). */}
      <a href={`/agenda/${actividad.id}`} class="group-hover:text-primary after:absolute after:inset-0 after:content-['']">{actividad.data.titulo}</a>
    </h3>
    <p class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-muted-foreground">
      <CalendarBlank class="size-4 shrink-0" aria-hidden="true" />
      <time datetime={actividad.data.inicio.toISOString()}>{formatoFecha(actividad.data.inicio)}</time>
      <span aria-hidden="true">·</span>
      <Clock class="size-4 shrink-0" aria-hidden="true" />
      <span>{hora(actividad.data.inicio)}</span>
    </p>
    <p class="flex items-center gap-1.5 text-sm text-muted-foreground">
      <MapPin class="size-4 shrink-0" aria-hidden="true" />{lugar}
    </p>
    {organizadores.length > 0 && (
      <p class="relative z-10 flex items-start gap-1.5 text-sm text-muted-foreground">
        <Users class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
        <span>{organizadores.map((o, i) => <>{i > 0 && ', '}<EnlaceFicha coleccion={o.coleccion} entrada={o.entrada} /></>)}</span>
      </p>
    )}
    {descripcion && <p class="line-clamp-3 text-sm text-muted-foreground">{descripcion}</p>}
    <div class="relative z-10 mt-auto pt-3">
      <Button as="a" href={String(enlace)} variant="outline" class="rounded-full" {...(externo ? { target: '_blank', rel: 'noopener' } : {})}>
        Más información<span class="sr-only"> sobre {actividad.data.titulo}</span><ArrowUpRight class="size-4" aria-hidden="true" />
      </Button>
    </div>
  </div>
</article>