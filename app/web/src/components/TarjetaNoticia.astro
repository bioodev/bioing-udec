---
import { getEntries } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { Badge } from '@/components/starwind/badge';
import { formatoFecha } from '@/lib/contenido';
import { existentes } from '@/lib/reglas';

interface Props { noticia: CollectionEntry<'noticias'> }
const { noticia } = Astro.props;
const temas = existentes(await getEntries(noticia.data.temas ?? []));
---
<article id={`noticia-${noticia.id}`} class="group tarjeta-elevada tarjeta-elevada-enlace relative flex h-full flex-col overflow-hidden rounded-lg border border-border bg-card">
  {noticia.data.imagen
    ? <Image src={noticia.data.imagen} alt={noticia.data.imagen_alt ?? ''} class="aspect-video w-full object-cover" widths={[400, 800]} sizes="(min-width: 768px) 33vw, 100vw" />
    : <div class="aspect-video w-full bg-muted" aria-hidden="true"></div>}
  <div class="flex flex-1 flex-col p-5">
    <div class="relative z-10 flex flex-wrap items-center gap-2">
      {temas.map((t) => <Badge variant="outline" href={`/noticias?tema=${t.id}`}>{t.data.nombre}</Badge>)}
    </div>
    <h3 class="mt-2 text-lg font-semibold leading-snug">
      {/* Enlace principal que extiende su área a toda la tarjeta (imagen incluida). */}
      <a href={`/noticias/${noticia.id}`} class="group-hover:text-primary after:absolute after:inset-0 after:content-['']">{noticia.data.titulo}</a>
    </h3>
    {noticia.data.bajada && <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{noticia.data.bajada}</p>}
    {noticia.data.etiquetas && noticia.data.etiquetas.length > 0 && (
      <div class="relative z-10 mt-3 flex flex-wrap gap-1.5">
        {noticia.data.etiquetas.map((etiqueta) => (
          <Badge variant="secondary" href={`/noticias?etiqueta=${encodeURIComponent(etiqueta)}`}>#{etiqueta}</Badge>
        ))}
      </div>
    )}
    <p class="mt-auto pt-3 text-sm text-muted-foreground">
      <time datetime={noticia.data.fecha.toISOString().slice(0, 10)}>{formatoFecha(noticia.data.fecha)}</time>
    </p>
  </div>
</article>