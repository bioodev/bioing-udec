---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import InstagramLogo from 'phosphor-astro/InstagramLogo.astro';
import ArrowSquareOut from 'phosphor-astro/ArrowSquareOut.astro';
import { formatoFecha } from '@/lib/contenido';
import { embedInstagram } from '@/lib/instagram';

interface Props { publicacion: CollectionEntry<'instagram'> }
const { titulo, enlace, fecha, imagen } = Astro.props.publicacion.data;
const embed = embedInstagram(enlace);
---
<article id={`instagram-${Astro.props.publicacion.id}`} class="publicacion-ig tarjeta-elevada tarjeta-elevada-enlace rounded-lg border border-border bg-card p-5" data-enlace={enlace} data-embed-src={embed} data-titulo={titulo}>
  {imagen && <Image src={imagen} alt="" widths={[320, 640]} sizes="(min-width: 768px) 33vw, 100vw" class="mb-4 aspect-square w-full rounded-md object-cover" />}
  <p class="flex items-center gap-1.5 text-sm text-muted-foreground"><InstagramLogo class="size-4" aria-hidden="true" /><time datetime={fecha.toISOString().slice(0, 10)}>{formatoFecha(fecha)}</time></p>
  <h3 class="mt-2 font-semibold leading-snug">{titulo}</h3>
  <div class="mt-4 flex flex-wrap gap-3 text-sm">
    <a href={enlace} target="_blank" rel="noopener" class="inline-flex items-center gap-1 hover:text-primary">Abrir en Instagram<ArrowSquareOut class="size-4" aria-hidden="true" /></a>
  </div>
  {embed && <p class="mt-2 text-xs text-muted-foreground">Contenido de Instagram (Meta)</p>}
  <div data-embed></div>
</article>

<script>
  // Instagram informa su altura con postMessage. Un solo listener para toda la página: el
  // script corre una vez y la ventana persiste entre navegaciones de ClientRouter.
  window.addEventListener('message', (event) => {
    if (event.origin !== 'https://www.instagram.com') return;
    let datos: unknown = event.data;
    if (typeof datos === 'string') {
      try { datos = JSON.parse(datos); } catch { return; }
    }
    const { type, details } = (datos ?? {}) as { type?: unknown; details?: { height?: unknown } };
    if (type !== 'MEASURE' || typeof details?.height !== 'number') return;
    const iframe = [...document.querySelectorAll<HTMLIFrameElement>('iframe[data-instagram]')]
      .find((f) => f.contentWindow === event.source);
    if (iframe) iframe.style.height = `${details.height}px`;
  });

  // El embed se crea solo cuando la tarjeta se acerca al viewport (200 px antes). Mientras carga, un esqueleto
  // del mismo tamaño ocupa su lugar; se quita con el evento load del iframe.
  function cargarEmbed(tarjeta: HTMLElement) {
    const envoltorio = document.createElement('div');
    envoltorio.className = 'relative mx-auto mt-4 w-full max-w-[540px]';
    const esqueleto = document.createElement('div');
    esqueleto.setAttribute('aria-hidden', 'true');
    esqueleto.className = 'absolute inset-0 rounded-lg bg-muted motion-safe:animate-pulse';
    const iframe = document.createElement('iframe');
    iframe.src = tarjeta.dataset.embedSrc!;
    iframe.title = `Publicación de Instagram: ${tarjeta.dataset.titulo}`;
    iframe.loading = 'lazy';
    iframe.setAttribute('allowtransparency', 'true');
    iframe.setAttribute('scrolling', 'no');
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.className = 'relative block w-full rounded-lg border-0 opacity-0 transition-opacity duration-300 motion-reduce:transition-none';
    iframe.style.height = '640px';
    iframe.dataset.instagram = '';
    iframe.addEventListener('load', () => {
      esqueleto.remove();
      iframe.classList.remove('opacity-0');
    }, { once: true });
    envoltorio.append(esqueleto, iframe);
    tarjeta.querySelector('[data-embed]')!.append(envoltorio);
  }

  // Los <script> de Astro corren una sola vez; con ClientRouter hay que reiniciar en cada
  // astro:page-load (también la primera carga). La marca data-iniciado evita observar dos veces.
  document.addEventListener('astro:page-load', () => {
    const observador = 'IntersectionObserver' in window
      ? new IntersectionObserver((entradas) => {
          for (const entrada of entradas) {
            if (!entrada.isIntersecting) continue;
            observador!.unobserve(entrada.target);
            cargarEmbed(entrada.target as HTMLElement);
          }
        }, { rootMargin: '200px' })
      : null;
    for (const tarjeta of document.querySelectorAll<HTMLElement>('.publicacion-ig:not([data-iniciado])')) {
      tarjeta.dataset.iniciado = '';
      if (!tarjeta.dataset.embedSrc) continue; // enlace no incrustable: la tarjeta queda sin iframe
      if (observador) observador.observe(tarjeta);
      else cargarEmbed(tarjeta);
    }
  });
</script>
