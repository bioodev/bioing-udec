---
// Sección destacada del Inicio: imagen de fondo con parallax (src/scripts/parallax.ts), capa oscura para que el
// texto blanco cumpla contraste AA en cualquier foto. Sin JavaScript la imagen queda centrada y fija.
// `imagen_alt` vacío = imagen decorativa (alt="").
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TarjetaContenido from '@/components/TarjetaContenido.astro';

interface Props {
  seccion: {
    etiqueta?: string;
    titulo: string;
    texto: string;
    boton: string;
    enlace: string;
    imagen: ImageMetadata;
    imagen_alt?: string;
  };
}
const { seccion } = Astro.props;
// Las secciones no tienen id propio: el ancla sale del título (sin tildes). Los títulos deben ser distintos.
const id = `inicio-seccion-${seccion.titulo.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---
<section id={id} class="relative isolate overflow-hidden bg-foreground text-white" aria-labelledby={`${id}-titulo`}>
  <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <!-- Más alta que la sección (175 %, centrada: -37,5 %) para que el parallax de ±20 % no deje bordes vacíos. -->
    <div data-parallax class="absolute inset-x-0 -top-[37.5%] h-[175%]">
      <Image
        src={seccion.imagen}
        alt={seccion.imagen_alt ?? ''}
        widths={[640, 960, 1280, 1920, 2560]}
        sizes="100vw"
        loading="lazy"
        class="h-full w-full object-cover"
      />
    </div>
    <div class="absolute inset-0 bg-black/60"></div>
  </div>

  <div class="mx-auto flex min-h-[50vh] max-w-6xl items-center px-4 py-16 md:min-h-[60vh] md:py-20">
    <div class="w-full md:w-[43%]">
      <TarjetaContenido
        etiqueta={seccion.etiqueta}
        titulo={seccion.titulo}
        tituloId={`${id}-titulo`}
        texto={seccion.texto}
        boton={seccion.boton}
        enlace={seccion.enlace}
      />
    </div>
  </div>
</section>
