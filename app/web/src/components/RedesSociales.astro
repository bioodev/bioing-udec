---
// Íconos de las redes con URL. Dos variantes con el mismo mapa de íconos: `pie` (columna de marca del pie, solo
// íconos) y `inicio` (sección «Síguenos» al final del Inicio: una columna por red, ícono en color primario y nombre como enlace).
// Cada enlace lleva su nombre accesible y se abre en una ventana nueva.
import type { IconoRed, RedVisible } from '@/lib/redes';
import ButterflyIcono from 'phosphor-astro/Butterfly.astro';
import FacebookLogo from 'phosphor-astro/FacebookLogo.astro';
import InstagramLogo from 'phosphor-astro/InstagramLogo.astro';
import LinkedinLogo from 'phosphor-astro/LinkedinLogo.astro';
import MastodonLogo from 'phosphor-astro/MastodonLogo.astro';
import ThreadsLogo from 'phosphor-astro/ThreadsLogo.astro';
import TiktokLogo from 'phosphor-astro/TiktokLogo.astro';
import XLogo from 'phosphor-astro/XLogo.astro';
import YoutubeLogo from 'phosphor-astro/YoutubeLogo.astro';

const iconos: Record<IconoRed, typeof InstagramLogo> = {
  InstagramLogo,
  FacebookLogo,
  XLogo,
  LinkedinLogo,
  YoutubeLogo,
  TiktokLogo,
  ThreadsLogo,
  Butterfly: ButterflyIcono,
  MastodonLogo,
};


interface Props { redes: RedVisible[]; variante?: 'pie' | 'inicio' }
const { redes, variante = 'pie' } = Astro.props;
---
{redes.length > 0 && variante === 'inicio' && (
  <section id="inicio-redes" class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="inicio-redes-titulo">
    <h2 id="inicio-redes-titulo" data-animar="fade-up" class="text-3xl font-semibold tracking-tight">Síguenos</h2>
    <ul role="list" data-animar="grilla" class="mt-8 grid grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-5">
      {redes.map((red) => {
        const Icono = iconos[red.icono];
        return (
          <li class="relative border-l-2 border-primary pl-5 text-primary">
            <Icono class="size-10" aria-hidden="true" />
            <a href={red.url} target="_blank" rel="noopener me" class="cta mt-4 block rounded-sm text-xl font-medium text-foreground after:absolute after:inset-0 hover:text-primary hover:underline focus-visible:ring-2 focus-visible:ring-outline focus-visible:outline-none">
              {red.etiqueta}
              <span class="sr-only"> (se abre en una ventana nueva)</span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}
{redes.length > 0 && variante === 'pie' && (
  <ul aria-label="Redes sociales" class="-ml-2.5 mt-4 flex flex-wrap gap-1">
    {redes.map((red) => {
      const Icono = iconos[red.icono];
      return (
        <li>
          <a href={red.url} target="_blank" rel="noopener me" title={`BIOING+ en ${red.etiqueta}`} class="inline-flex size-11 items-center justify-center rounded-md text-muted-foreground hover:text-primary focus-visible:ring-2 focus-visible:ring-outline focus-visible:outline-none">
            <Icono class="size-5" aria-hidden="true" />
            <span class="sr-only">BIOING+ en {red.etiqueta} (se abre en una ventana nueva)</span>
          </a>
        </li>
      );
    })}
  </ul>
)}
