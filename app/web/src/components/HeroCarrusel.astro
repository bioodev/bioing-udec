---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { Button } from '@/components/starwind/button';
import ArrowRight from 'phosphor-astro/ArrowRight.astro';
import CaretLeft from 'phosphor-astro/CaretLeft.astro';
import CaretRight from 'phosphor-astro/CaretRight.astro';

interface Props { banners: CollectionEntry<'banners'>[] }
const { banners } = Astro.props;
const externo = (enlace: string) => /^https?:\/\//.test(enlace);
const varios = banners.length > 1;
---
<!-- Hero en carrusel: un slide por Banner vigente. Autoplay con pausa al hover/foco,
     flechas y puntos; respeta prefers-reduced-motion (wireframes: Inicio). -->
<section
  id="inicio-carrusel"
  class="relative isolate overflow-hidden bg-foreground text-background"
  data-carrusel
  aria-roledescription="carrusel"
  aria-label="Destacados"
>
  <div class="flex cursor-grab touch-pan-y select-none active:cursor-grabbing transition-transform duration-500 ease-out motion-reduce:transition-none" data-carrusel-track>
    {banners.map((banner, i) => (
      <div
        class="relative min-w-full"
        data-slide
        aria-roledescription="diapositiva"
        aria-label={`${i + 1} de ${banners.length}`}
        inert={i !== 0 ? '' : undefined}
      >
        <Image
          src={banner.data.imagen}
          alt=""
          class="hero-imagen absolute inset-0 -z-10 h-full w-full object-cover opacity-70"
          widths={[640, 1280, 1920]}
          sizes="100vw"
          priority={i === 0}
        />
        <div class="mx-auto flex min-h-[32rem] max-w-6xl flex-col items-center justify-center px-4 py-24 text-center sm:min-h-[36rem]">
          <h1 data-animar="hero" class="max-w-3xl text-4xl font-semibold tracking-tight sm:text-6xl">{banner.data.titulo}</h1>
          {banner.data.texto && <p data-animar="hero" class="mx-auto mt-4 max-w-2xl text-lg opacity-90">{banner.data.texto}</p>}
          <Button
            data-animar="hero"
            href={banner.data.enlace}
            variant="primary"
            class="mt-8 rounded-full"
            {...(externo(banner.data.enlace) ? { target: '_blank', rel: 'noopener' } : {})}
          >
            Conoce más<ArrowRight class="size-4" aria-hidden="true" />
          </Button>
        </div>
      </div>
    ))}
  </div>

  <!-- Velo oscuro sutil: mantiene el contraste del texto blanco sobre la foto. -->
  <div class="absolute inset-0 -z-10 bg-foreground/30" aria-hidden="true"></div>

  {varios && (
    <>
      {/* Los contenedores de los controles cubren todo el alto o el ancho: no deben tapar el swipe, solo los botones reciben el puntero. */}
      <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center">
        <button
          type="button"
          data-carrusel-anterior
          aria-label="Anterior"
          class="pointer-events-auto m-3 flex size-11 items-center justify-center rounded-full bg-background/20 text-background backdrop-blur transition hover:bg-background/35 focus-visible:ring-2 focus-visible:ring-outline focus-visible:outline-none"
        >
          <CaretLeft class="size-6" aria-hidden="true" />
        </button>
      </div>
      <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center">
        <button
          type="button"
          data-carrusel-siguiente
          aria-label="Siguiente"
          class="pointer-events-auto m-3 flex size-11 items-center justify-center rounded-full bg-background/20 text-background backdrop-blur transition hover:bg-background/35 focus-visible:ring-2 focus-visible:ring-outline focus-visible:outline-none"
        >
          <CaretRight class="size-6" aria-hidden="true" />
        </button>
      </div>
      <div class="pointer-events-none absolute inset-x-0 bottom-4 flex justify-center gap-2" role="group" aria-label="Elegir diapositiva">
        {banners.map((_, i) => (
          <button
            type="button"
            data-punto
            aria-label={`Ir a la diapositiva ${i + 1}`}
            aria-current={i === 0 ? 'true' : undefined}
            class="pointer-events-auto h-2.5 w-2.5 rounded-full bg-background/40 transition hover:bg-background/70 focus-visible:ring-2 focus-visible:ring-outline focus-visible:outline-none aria-[current=true]:bg-background"
          ></button>
        ))}
      </div>
    </>
  )}
</section>

<script>
  import { destinoArrastre } from '@/lib/carrusel';

  // Compartido entre re-evaluaciones del módulo (ClientRouter navega sin recargar):
  // se registran los intervalos de autoplay para limpiarlos al salir de la página.
  type VentanaCarrusel = Window & { __carruseles?: Set<number> };
  const activos = ((window as VentanaCarrusel).__carruseles ??= new Set<number>());

  function iniciarCarrusel() {
    const root = document.querySelector<HTMLElement>('[data-carrusel]');
    if (!root || root.dataset.carruselIniciado) return;
    root.dataset.carruselIniciado = '1';

    const track = root.querySelector<HTMLElement>('[data-carrusel-track]')!;
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const anterior = root.querySelector<HTMLButtonElement>('[data-carrusel-anterior]');
    const siguiente = root.querySelector<HTMLButtonElement>('[data-carrusel-siguiente]');
    const puntos = [...root.querySelectorAll<HTMLButtonElement>('[data-punto]')];
    const reducirMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const INTERVALO = 6000;
    let actual = 0;
    let temporizador: number | undefined;

    function mostrar(i: number) {
      if (slides.length === 0) return;
      actual = (i + slides.length) % slides.length;
      track.style.transform = `translateX(-${actual * 100}%)`;
      slides.forEach((s, j) => {
        s.toggleAttribute('inert', j !== actual);
        s.setAttribute('aria-hidden', String(j !== actual));
      });
      puntos.forEach((p, j) => p.setAttribute('aria-current', String(j === actual)));
    }

    function detener() {
      if (temporizador !== undefined) {
        window.clearInterval(temporizador);
        activos.delete(temporizador);
        temporizador = undefined;
      }
    }
    function reanudar() {
      detener();
      if (reducirMovimiento || slides.length <= 1) return;
      temporizador = window.setInterval(() => mostrar(actual + 1), INTERVALO);
      activos.add(temporizador);
    }

    anterior?.addEventListener('click', () => { mostrar(actual - 1); reanudar(); });
    siguiente?.addEventListener('click', () => { mostrar(actual + 1); reanudar(); });
    puntos.forEach((p, j) => p.addEventListener('click', () => { mostrar(j); reanudar(); }));
    // Swipe con dedo o mouse: el track sigue al puntero y, al soltar, destinoArrastre decide si cambia de slide.
    // touch-action: pan-y (en el track) deja el scroll vertical al navegador; solo se capturan gestos horizontales.
    if (slides.length > 1) {
      let inicioX = 0;
      let inicioY = 0;
      let inicioT = 0;
      let dx = 0;
      let arrastrando = false;
      let horizontal: boolean | undefined;
      let suprimirClic = false;

      track.addEventListener('pointerdown', (e) => {
        if (!e.isPrimary || (e.pointerType === 'mouse' && e.button !== 0)) return;
        arrastrando = true;
        horizontal = undefined;
        inicioX = e.clientX;
        inicioY = e.clientY;
        inicioT = performance.now();
        dx = 0;
      });
      track.addEventListener('pointermove', (e) => {
        if (!arrastrando) return;
        dx = e.clientX - inicioX;
        const dy = e.clientY - inicioY;
        if (horizontal === undefined && Math.hypot(dx, dy) > 8) {
          horizontal = Math.abs(dx) > Math.abs(dy);
          if (!horizontal) { arrastrando = false; return; } // es scroll vertical: no es nuestro
          track.setPointerCapture(e.pointerId);
          track.style.transition = 'none';
          detener();
        }
        if (horizontal) track.style.transform = `translateX(calc(-${actual * 100}% + ${dx}px))`;
      });
      const soltar = () => {
        if (!arrastrando) return;
        arrastrando = false;
        if (!horizontal) return;
        track.style.transition = '';
        suprimirClic = Math.abs(dx) > 8; // un arrastre no debe activar el enlace «Conoce más» que quedó debajo
        mostrar(actual + destinoArrastre({ dx, ancho: root.clientWidth, ms: performance.now() - inicioT }));
        reanudar();
      };
      track.addEventListener('pointerup', soltar);
      track.addEventListener('pointercancel', soltar);
      track.addEventListener('click', (e) => {
        if (suprimirClic) { e.preventDefault(); e.stopPropagation(); suprimirClic = false; }
      }, true);
      track.addEventListener('dragstart', (e) => e.preventDefault()); // sin arrastre nativo de imágenes y enlaces
    }

    root.addEventListener('mouseenter', detener);
    root.addEventListener('mouseleave', reanudar);
    root.addEventListener('focusin', detener);
    root.addEventListener('focusout', reanudar);

    // Al navegar fuera con View Transitions se limpian los intervalos activos
    // (los de instancias previas también, por si algún módulo quedó re-ejecutado).
    window.addEventListener('astro:before-swap', () => {
      activos.forEach((id) => window.clearInterval(id));
      activos.clear();
    });

    mostrar(0);
    reanudar();
  }

  // Carga inicial y cada navegación (astro:page-load también corre en la inicial).
  document.addEventListener('astro:page-load', iniciarCarrusel);
  iniciarCarrusel();
</script>

<style>
  /* Tinte cálido sutil para las imágenes del hero (la foto debe verse). */
  .hero-imagen {
    filter: sepia(0.22) saturate(1.06) brightness(0.95);
  }
</style>