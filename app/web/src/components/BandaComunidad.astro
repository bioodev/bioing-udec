---
// Banda «Comunidad y documentos» del Inicio: una tarjeta por sección activa (Directorio y Repositorio), con cifras y
// buscador en el Directorio, y los documentos más recientes en el Repositorio. Los datos llegan de `bandaComunidad`.
// Las tarjetas van una bajo otra, a todo el ancho; dentro, en escritorio, dos columnas: a la izquierda la presentación
// (imagen, título, texto y botón) y a la derecha los datos (cifras, áreas y buscador; o los últimos documentos). En
// móvil el orden es presentación → datos → botón (el orden del DOM; en escritorio el botón se ubica con la grilla).
import { Image } from 'astro:assets';
import type { bandaComunidad } from '@/lib/contenido';
import { Input } from '@/components/starwind/input';
import { Label } from '@/components/starwind/label';
import { TIPOS_DOCUMENTO } from '@/lib/repositorio';
import ArrowRight from 'phosphor-astro/ArrowRight.astro';
import ArrowSquareOut from 'phosphor-astro/ArrowSquareOut.astro';
import MagnifyingGlass from 'phosphor-astro/MagnifyingGlass.astro';

type Banda = NonNullable<Awaited<ReturnType<typeof bandaComunidad>>>;
interface Props { banda: Banda }
const { banda } = Astro.props;
---
<section id="inicio-comunidad" class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="inicio-comunidad-titulo">
  <h2 id="inicio-comunidad-titulo" data-animar="fade-up" class="text-3xl font-semibold tracking-tight">{banda.titulo}</h2>

  <div data-animar="grilla" class="mt-8 grid gap-6">
    {banda.tarjetas.includes('directorio') && (
      <article id="inicio-directorio" aria-labelledby="inicio-directorio-titulo" class="tarjeta-elevada tarjeta-elevada-enlace grid rounded-lg border border-border bg-card p-6 sm:p-8 md:grid-cols-2 md:gap-x-10">
        <div class="md:col-start-1 md:row-start-1">
        {banda.directorio.imagen && (
          <Image
            src={banda.directorio.imagen}
            alt={banda.directorio.imagen_alt ?? ''}
            widths={[480, 960, 1280]}
            sizes="(min-width: 768px) 560px, 100vw"
            loading="lazy"
            class="mb-5 aspect-[21/9] w-full rounded-md object-cover"
          />
        )}
        <h3 id="inicio-directorio-titulo" class="text-xl font-semibold tracking-tight">{banda.directorio.titulo}</h3>
        <p class="mt-2 text-muted-foreground">{banda.directorio.texto}</p>
        </div>

        <div class="mt-6 flex flex-col gap-6 md:col-start-2 md:row-span-2 md:row-start-1 md:mt-0">

        {banda.cifras.length > 0 && (
          <dl class="grid grid-cols-3 gap-4 text-center">
            {banda.cifras.map((c) => (
              <div>
                <dt class="text-xs text-muted-foreground sm:text-sm">{c.etiqueta}</dt>
                <dd class="text-2xl font-semibold tracking-tight sm:text-3xl">{c.valor}</dd>
              </div>
            ))}
          </dl>
        )}

        {banda.areas.length > 0 && (
          <nav aria-labelledby="inicio-areas-titulo">
            <p id="inicio-areas-titulo" class="text-sm font-medium">Explora por área</p>
            <ul role="list" class="mt-2 flex flex-wrap gap-2">
              {banda.areas.map((a) => (
                <li>
                  <a href={`/directorio?area=${a.id}`} class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border px-4 text-sm hover:bg-muted">
                    {a.nombre}<span class="text-muted-foreground">{a.cantidad}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}

        <form action="/directorio" method="get" role="search" class="flex flex-wrap gap-3">
          <div class="grid min-w-0 flex-1 basis-56 gap-2">
            <Label for="inicio-directorio-texto" class="sr-only">Buscar egresado o egresada por nombre</Label>
            <Input id="inicio-directorio-texto" name="texto" type="search" placeholder="Buscar por nombre" autocomplete="off" />
          </div>
          <button type="submit" class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border px-5 font-medium hover:bg-muted">
            <MagnifyingGlass class="size-4" aria-hidden="true" />Buscar
          </button>
        </form>

        </div>

        <div class="pt-6 md:col-start-1 md:row-start-2 md:self-end">
          <a href="/directorio" class="inline-flex min-h-11 w-fit items-center gap-2 rounded-full bg-primary px-6 text-primary-foreground hover:opacity-90">
            {banda.directorio.boton}<ArrowRight class="size-4" aria-hidden="true" />
          </a>
        {banda.formulario && (
          <p class="mt-4 text-sm text-muted-foreground">
            ¿Eres egresado/a?{' '}
            <a href={banda.formulario} target="_blank" rel="noopener" class="inline-flex items-center gap-1 font-medium text-primary hover:underline">
              Suma tu perfil<ArrowSquareOut class="size-4" aria-hidden="true" /><span class="sr-only"> (se abre en una ventana nueva)</span>
            </a>
          </p>
        )}
        </div>
      </article>
    )}

    {banda.tarjetas.includes('repositorio') && (
      <article id="inicio-repositorio" aria-labelledby="inicio-repositorio-titulo" class="tarjeta-elevada tarjeta-elevada-enlace grid rounded-lg border border-border bg-card p-6 sm:p-8 md:grid-cols-2 md:gap-x-10">
        <div class="md:col-start-1 md:row-start-1">
        {banda.repositorio.imagen && (
          <Image
            src={banda.repositorio.imagen}
            alt={banda.repositorio.imagen_alt ?? ''}
            widths={[480, 960, 1280]}
            sizes="(min-width: 768px) 560px, 100vw"
            loading="lazy"
            class="mb-5 aspect-[21/9] w-full rounded-md object-cover"
          />
        )}
        <h3 id="inicio-repositorio-titulo" class="text-xl font-semibold tracking-tight">{banda.repositorio.titulo}</h3>
        <p class="mt-2 text-muted-foreground">{banda.repositorio.texto}</p>
        </div>

        <div class="mt-6 flex flex-col gap-6 md:col-start-2 md:row-span-2 md:row-start-1 md:mt-0">

        {banda.documentos.length > 0 && (
          <ul role="list" class="divide-y divide-border">
            {banda.documentos.map((d) => (
              <li id={`documento-${d.id}`} class="py-3">
                <a href={`/repositorio/${d.id}`} class="font-medium hover:text-primary hover:underline">{d.data.titulo}</a>
                <span class="block text-sm text-muted-foreground">{TIPOS_DOCUMENTO[d.data.tipo]} · {d.data.anio}</span>
              </li>
            ))}
          </ul>
        )}

        </div>

        <div class="pt-6 md:col-start-1 md:row-start-2 md:self-end">
          <a href="/repositorio" class="inline-flex min-h-11 w-fit items-center gap-2 rounded-full bg-primary px-6 text-primary-foreground hover:opacity-90">
            {banda.repositorio.boton}<ArrowRight class="size-4" aria-hidden="true" />
          </a>
        </div>
      </article>
    )}
  </div>
</section>
