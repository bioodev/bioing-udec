---
// Página destacada del Inicio: bloque entre el carrusel de Banners y las Noticias (src/lib/contenido.ts,
// paginaDestacadaInicio). Texto y, si la página lo tiene, video (VideoModal) e imagen. En escritorio, la imagen
// va a un lado del texto; en móvil, arriba. Sin imagen, el video ocupa ese lado para no dejar media sección vacía.
// El texto va en la TarjetaContenido de las Secciones destacadas (etiqueta, título, línea, resumen, botón).
// Sin JavaScript propio: el video usa el VideoModal existente.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import VideoModal from '@/components/VideoModal.astro';
import TarjetaContenido from '@/components/TarjetaContenido.astro';
import { idYouTube } from '@/lib/enlaces';

interface Props { pagina: CollectionEntry<'paginasLibres'> }
const { pagina } = Astro.props;
const { titulo, bajada, etiqueta_inicio, resumen_inicio, imagen, imagen_alt, video, bloques } = pagina.data;

const idVideo = video ? idYouTube(video) : null;
// Los títulos de los bloques destacados se muestran como «datos clave» (hasta 3, en chips).
const clavesDe = (bloques ?? []).slice(0, 3);
// El video va al lado del texto solo si no hay imagen que ocupe ese lugar; si no, queda bajo el texto.
const videoAlLado = !imagen && idVideo;
const dosColumnas = imagen || videoAlLado;
---
<section id="inicio-pagina-destacada" class="bg-muted" aria-labelledby="inicio-pagina-destacada-titulo">
  <div class={`mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 ${dosColumnas ? 'md:grid-cols-2' : ''}`}>
    {imagen && (
      <Image
        src={imagen}
        alt={imagen_alt ?? ''}
        widths={[640, 960, 1280]}
        sizes="(min-width: 768px) 50vw, 100vw"
        data-animar="fade-up"
        class="aspect-video w-full rounded-lg object-cover"
      />
    )}
    {videoAlLado && (
      <div data-animar="fade-up">
        <VideoModal id={idVideo} titulo={`Video: ${titulo}`} />
      </div>
    )}
    <div class={dosColumnas ? '' : 'max-w-2xl'}>
      <TarjetaContenido
        etiqueta={etiqueta_inicio || 'Destacado'}
        titulo={titulo}
        tituloId="inicio-pagina-destacada-titulo"
        texto={resumen_inicio ?? bajada}
        boton="Ver más"
        enlace={`/p/${pagina.id}`}
        botonOculto={`sobre ${titulo}`}
      >
        {clavesDe.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2">
            {clavesDe.map((b) => (
              <li class="rounded-full border border-border bg-background px-3 py-1 text-sm">{b.titulo}</li>
            ))}
          </ul>
        )}

        {idVideo && !videoAlLado && (
          <div class="mt-6 max-w-md">
            <VideoModal id={idVideo} titulo={`Video: ${titulo}`} />
          </div>
        )}
      </TarjetaContenido>
    </div>
  </div>
</section>
