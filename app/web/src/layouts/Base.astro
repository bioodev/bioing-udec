---
import '@/styles/starwind.css';
import '@/styles/animaciones.css';
import '@/styles/transitions.css';
import { ClientRouter } from 'astro:transitions';
import { Sheet, SheetClose, SheetContent, SheetHeader, SheetTitle, SheetTrigger } from '@/components/starwind/sheet';
import IconMenu from 'phosphor-astro/List.astro';
import ArrowUpRight from 'phosphor-astro/ArrowUpRight.astro';
import InstagramLogo from 'phosphor-astro/InstagramLogo.astro';
import MagnifyingGlass from 'phosphor-astro/MagnifyingGlass.astro';
import Logo from '@/components/Logo.astro';
import { MENU, URL_FCB } from '@/lib/navegacion';
import ogPorDefecto from '@/assets/og-default.png';

interface Props { titulo: string; descripcion?: string; imagen?: string }
const { titulo, descripcion = 'Plataforma de la comunidad de Bioingeniería de la Universidad de Concepción.', imagen } = Astro.props;
const tituloPagina = titulo === 'BIOING+' ? titulo : `${titulo} · BIOING+`;
const actual = Astro.url.pathname;
const esActual = (href: string) => (href === '/' ? actual === '/' : actual.startsWith(href));
// URL absoluta para canonical y Open Graph (Astro.site está definido en astro.config.mjs).
const canonical = new URL(actual, Astro.site).href;
const imagenOG = imagen ? new URL(imagen, Astro.site).href : new URL(ogPorDefecto.src, Astro.site).href;
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <script is:inline>
      // Animaciones de entrada (GSAP): activas solo con JS y sin prefers-reduced-motion.
      // La clase .anima oculta [data-animar] vía CSS; un guard la quita si el módulo de
      // animación no llega a ejecutarse, para que el contenido nunca quede oculto.
      (() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('anima');
        setTimeout(() => {
          if (!document.documentElement.hasAttribute('data-animaciones')) {
            document.documentElement.classList.remove('anima');
          }
        }, 3000);
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BIOING+" />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenOG} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloPagina} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOG} />
    <title>{tituloPagina}</title>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-background focus:px-4 focus:py-2 focus:shadow-lg print:hidden">Saltar al contenido</a>
    <header transition:name="encabezado" class="sticky top-0 z-40 border-b border-border bg-background/85 backdrop-blur print:hidden">
      <div class="mx-auto flex h-14 max-w-6xl items-center gap-4 px-4">
        <a href="/" class="flex items-center gap-2" aria-label="BIOING+ — Inicio"><Logo variante="navbar" /></a>
        <nav aria-label="Principal" class="hidden lg:flex flex-1 items-center gap-5 text-sm">
          {MENU.map((item) => (
            <a href={item.href} aria-current={esActual(item.href) ? 'page' : undefined}
               class:list={['hover:text-primary', esActual(item.href) ? 'text-primary' : 'text-foreground']}>
              {item.etiqueta}
            </a>
          ))}
          <a href="/buscar" aria-label="Buscar en el sitio" title="Buscar" class="text-muted-foreground hover:text-primary"><MagnifyingGlass class="size-4" aria-hidden="true" /></a>
        </nav>
        <a href={URL_FCB} class="ml-auto hidden lg:inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-primary">FCB UdeC <ArrowUpRight class="size-3.5" aria-hidden="true" /></a>
        <div class="ml-auto lg:hidden">
          <Sheet>
            <SheetTrigger aria-label="Abrir menú" class="p-2"><IconMenu class="size-6" aria-hidden="true" /></SheetTrigger>
            <SheetContent side="left">
              <SheetHeader><SheetTitle>BIOING+</SheetTitle></SheetHeader>
              <nav aria-label="Principal (móvil)" class="grid gap-1 px-4">
                {MENU.map((item) => (
                  <SheetClose asChild>
                    <a href={item.href} aria-current={esActual(item.href) ? 'page' : undefined}
                       class="rounded-md px-2 py-2 hover:bg-muted">{item.etiqueta}</a>
                  </SheetClose>
                ))}
                <SheetClose asChild>
                  <a href="/buscar" class="inline-flex items-center gap-2 rounded-md px-2 py-2 hover:bg-muted"><MagnifyingGlass class="size-4" aria-hidden="true" />Buscar</a>
                </SheetClose>
                <a href={URL_FCB} class="mt-4 inline-flex items-center gap-1 px-2 py-2 text-muted-foreground">Facultad de Ciencias Biológicas <ArrowUpRight class="size-3.5" aria-hidden="true" /></a>
              </nav>
            </SheetContent>
          </Sheet>
        </div>
      </div>
    </header>

    <main id="contenido" transition:name="contenido" data-pagefind-body class="flex-1">
      <slot />
    </main>

    <footer class="bg-muted text-sm print:hidden">
      <div class="mx-auto grid max-w-6xl gap-6 px-4 py-10 sm:grid-cols-3">
        <div>
          <div class="flex items-center gap-2"><Logo variante="footer" /></div>
          <p class="text-muted-foreground">FCB UdeC · Universidad de Concepción</p>
        </div>
        <nav aria-label="Pie de página" class="grid gap-1">
          <a href={URL_FCB} class="inline-flex items-center gap-1 hover:text-primary">Facultad de Ciencias Biológicas <ArrowUpRight class="size-3.5" aria-hidden="true" /></a>
          <a href="/instagram" class="inline-flex items-center gap-1.5 hover:text-primary"><InstagramLogo class="size-4" aria-hidden="true" />Instagram</a>
          <a href="/directorio" class="hover:text-primary">Directorio de egresados/as</a>
        </nav>
        <p class="text-muted-foreground">Contacto: pendiente de definir con el equipo BIOING+.</p>
      </div>
    </footer>
  </body>
  <script>
    import { iniciarAnimaciones, limpiarAnimaciones } from '@/scripts/animaciones';
    // View Transitions (ClientRouter): limpiar antes de reemplazar el DOM y
    // reinicializar en la carga inicial y tras cada navegación (astro:page-load).
    document.addEventListener('astro:before-swap', limpiarAnimaciones);
    document.addEventListener('astro:page-load', iniciarAnimaciones);
  </script>
</html>
