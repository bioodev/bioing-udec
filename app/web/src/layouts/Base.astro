---
import '@/styles/starwind.css';
import '@/styles/animaciones.css';
import '@/styles/transitions.css';
import { ClientRouter } from 'astro:transitions';
import ArrowUpRight from 'phosphor-astro/ArrowUpRight.astro';
import InstagramLogo from 'phosphor-astro/InstagramLogo.astro';
import Logo from '@/components/Logo.astro';
import Navbar from '@/components/Navbar.astro';
import { MENU, URL_FCB } from '@/lib/navegacion';
import { jsonLd as serializarJsonLd, sitioWeb, type JsonLd } from '@/lib/schema';
import ogPorDefecto from '@/assets/og-default.png';

interface Props { titulo: string; descripcion?: string; imagen?: string; jsonLd?: JsonLd | JsonLd[] }
const { titulo, descripcion = 'Plataforma de la comunidad de Bioingeniería de la Universidad de Concepción.', imagen, jsonLd: jsonLdPagina } = Astro.props;
const tituloPagina = titulo === 'BIOING+' ? titulo : `${titulo} · BIOING+`;
const actual = Astro.url.pathname;
// URL absoluta para canonical y Open Graph (Astro.site está definido en astro.config.mjs).
const canonical = new URL(actual, Astro.site).href;
const imagenOG = imagen ? new URL(imagen, Astro.site).href : new URL(ogPorDefecto.src, Astro.site).href;
// Datos estructurados: WebSite + Organization del sitio en todas las páginas, más los
// bloques propios de la página (migas, entidad de la ficha, listados…).
const bloquesSitio = sitioWeb(Astro.site);
const bloquesPagina = jsonLdPagina ? (Array.isArray(jsonLdPagina) ? jsonLdPagina : [jsonLdPagina]) : [];
---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Tema claro/oscuro ANTES del primer pintado (sin FOUC). Precedencia:
      // preferencia guardada (localStorage "tema") > preferencia del sistema.
      (() => {
        let guardado = null;
        try { guardado = localStorage.getItem('tema'); } catch { /* privado */ }
        const oscuro = guardado === 'oscuro' || (guardado !== 'claro' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', oscuro);
      })();
    </script>
    <meta name="description" content={descripcion} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <script is:inline>
      // Animaciones de entrada (GSAP): activas solo con JS y sin prefers-reduced-motion.
      // La clase .anima oculta [data-animar] vía CSS; un guard la quita si el módulo de
      // animación no llega a ejecutarse, para que el contenido nunca quede oculto.
      (() => {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        document.documentElement.classList.add('anima');
        setTimeout(() => {
          if (!document.documentElement.hasAttribute('data-animaciones')) {
            document.documentElement.classList.remove('anima');
          }
        }, 3000);
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BIOING+" />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagenOG} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloPagina} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={imagenOG} />
    <title>{tituloPagina}</title>
    <script type="application/ld+json" set:html={serializarJsonLd(bloquesSitio)} />
    {bloquesPagina.length > 0 && (
      <script type="application/ld+json" set:html={serializarJsonLd(bloquesPagina.length === 1 ? bloquesPagina[0]! : bloquesPagina)} />
    )}
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-background focus:px-4 focus:py-2 focus:shadow-lg print:hidden">Saltar al contenido</a>
    <Navbar />

    <main id="contenido" transition:name="contenido" data-pagefind-body class="flex-1">
      <slot />
    </main>

    <footer class="bg-muted print:hidden">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Marca -->
          <div class="lg:col-span-1">
            <div class="flex items-center gap-2"><Logo variante="footer" /></div>
            <p class="mt-3 max-w-xs text-sm text-muted-foreground">
              Plataforma de la comunidad de Bioingeniería de la Universidad de Concepción: noticias,
              actividades, oportunidades, documentos y el directorio de egresados/as.
            </p>
            <a href={URL_FCB} class="mt-4 inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-primary">
              Facultad de Ciencias Biológicas <ArrowUpRight class="size-3.5" aria-hidden="true" />
            </a>
          </div>

          <!-- Navegación principal (misma fuente que el menú) -->
          <nav aria-label="Navegación del pie" class="text-sm">
            <h2 class="text-sm font-semibold tracking-tight">Navegación</h2>
            <ul class="mt-3 grid gap-2">
              {MENU.filter((item) => item.href !== '/').map((item) => (
                <li><a href={item.href} class="text-muted-foreground hover:text-primary">{item.etiqueta}</a></li>
              ))}
            </ul>
          </nav>

          <!-- Comunidad -->
          <nav aria-label="Comunidad" class="text-sm">
            <h2 class="text-sm font-semibold tracking-tight">Comunidad</h2>
            <ul class="mt-3 grid gap-2">
              <li>
                <a href="/instagram" class="inline-flex items-center gap-1.5 text-muted-foreground hover:text-primary">
                  <InstagramLogo class="size-4" aria-hidden="true" />Instagram
                </a>
              </li>
              <li><a href="/directorio" class="text-muted-foreground hover:text-primary">Directorio de egresados/as</a></li>
              <li><a href="/buscar" class="text-muted-foreground hover:text-primary">Buscar en el sitio</a></li>
            </ul>
          </nav>

          <!-- Contacto -->
          <div class="text-sm">
            <h2 class="text-sm font-semibold tracking-tight">Contacto</h2>
            <p class="mt-3 text-muted-foreground">
              El canal de contacto para la comunidad se está definiendo con el equipo BIOING+.
            </p>
            <p class="mt-3 text-muted-foreground">FCB UdeC · Universidad de Concepción</p>
          </div>
        </div>

        <div class="mt-10 flex flex-col items-center justify-between gap-2 border-t border-border pt-6 text-xs text-muted-foreground sm:flex-row">
          <p>© {new Date().getFullYear()} BIOING+ · Facultad de Ciencias Biológicas, Universidad de Concepción</p>
          <p>Plataforma de la comunidad de Bioingeniería UdeC</p>
        </div>
      </div>
    </footer>
  </body>
  <script>
    import { iniciarAnimaciones, limpiarAnimaciones } from '@/scripts/animaciones';
    import { iniciarFiltrosPlegables } from '@/scripts/filtros-plegables';
    import { iniciarNavbar } from '@/scripts/navbar';

    // Tema claro/oscuro: ClientRouter (View Transitions) puede resetear las clases del
    // <html> al navegar (lo mismo que pasa con .anima), así que se re-aplica la preferencia
    // tras cada navegación (astro:page-load corre en la carga inicial y en cada una).
    // Misma lógica que el script inline anti-FOUC del <head> (localStorage > sistema).
    function aplicarTema() {
      let guardado = null;
      try { guardado = localStorage.getItem('tema'); } catch { /* privado */ }
      const oscuro = guardado === 'oscuro' || (guardado !== 'claro' && matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', oscuro);
    }

    // View Transitions (ClientRouter): limpiar antes de reemplazar el DOM y
    // reinicializar en la carga inicial y tras cada navegación (astro:page-load).
    document.addEventListener('astro:before-swap', limpiarAnimaciones);
    document.addEventListener('astro:page-load', () => {
      aplicarTema();
      iniciarAnimaciones();
      iniciarFiltrosPlegables();
      iniciarNavbar();
    });

    // Los formularios de filtros (role="search") filtran en el cliente: Enter no debe enviarlos.
    // Va delegado aquí y no como onsubmit="…" en el HTML, porque la CSP pública no admite
    // manejadores de eventos inline.
    document.addEventListener('submit', (evento) => {
      if (evento.target instanceof HTMLFormElement && evento.target.matches('form[role="search"]')) {
        evento.preventDefault();
      }
    });
  </script>
</html>
