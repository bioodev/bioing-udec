// Configuración de despliegue en Cloudflare (Workers Static Assets).
// Deploy manual al Worker de QA (bioing-web-qa): npm run deploy:dev. Producción solo por Workers Builds.
// El deploy definitivo se conectará a Workers Builds en la Fase C (sin secretos aquí).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bioing-web",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist",
    // Rutas inexistentes: sirve dist/404.html con estado 404 (el 404 propio del sitio).
    "not_found_handling": "404-page",
    // Carpetas con index.html se sirven con barra final; los .html sueltos, sin ella.
    "html_handling": "auto-trailing-slash"
  },
  // Ambientes (docs/plans/2026-10-11-plan-ambientes-qa-produccion.md):
  //   producción = este nivel superior → Worker "bioing-web" (rama main)
  //   QA         = env.qa → Worker "bioing-web-qa" (a mano: npm run deploy:dev), siempre en *.workers.dev
  // El dominio oficial se agrega aquí con "routes" + "custom_domain": true cuando exista (Fase C).
  "env": {
    "qa": {}
  }
}
