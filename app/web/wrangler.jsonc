// Configuración de despliegue en Cloudflare (Workers Static Assets).
// Deploy manual (ambiente de desarrollo): npm run deploy:dev
// El deploy definitivo se conectará a Workers Builds en la Fase C (sin secretos aquí).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bioing-web",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./dist",
    // Rutas inexistentes: sirve dist/404.html con estado 404 (el 404 propio del sitio).
    "not_found_handling": "404-page",
    // Carpetas con index.html se sirven con barra final; los .html sueltos, sin ella.
    "html_handling": "auto-trailing-slash"
  }
}
